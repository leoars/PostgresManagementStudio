<UserControl x:Class="PGMS.Desktop.ActivityMonitorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PGMS.Desktop" Background="#F5F5F5" Loaded="OnLoaded" AutomationProperties.Name="Activity Monitor">
 <UserControl.Resources>
  <Style x:Key="PanelGrid" TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="Height" Value="190"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
  <Style x:Key="ChartTitle" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="PanelNote" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,0"/></Style>
  <Style x:Key="QueryCell" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Query}"/></Style>
  <!-- SSMS 22.11 keeps the selected row solid blue when the grid loses focus (M1030); WPF's default inactive highlight is near white. -->
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{x:Static SystemColors.HighlightColor}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{x:Static SystemColors.HighlightTextColor}"/>
  <!-- Panel headers like SSMS 22.11: bold title, round collapse button on the right and a rule under the header (M1030). The whole header is one toggle button,
       so keyboard focus, Space/Enter and the Expander's expand/collapse automation pattern stay as before. -->
  <Style TargetType="Expander">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Expander">
      <DockPanel>
       <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bar" Background="Transparent" BorderBrush="#CCCEDB" BorderThickness="0,0,0,1" Padding="2,3,4,4">
           <DockPanel>
            <Grid DockPanel.Dock="Right" Width="17" Height="17" VerticalAlignment="Center">
             <Ellipse x:Name="Circle" Stroke="#717171" StrokeThickness="1" Fill="#FFFFFF"/>
             <Path x:Name="Arrow" Data="M 0,4 L 4,0 L 8,4" Stroke="#1E1E1E" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
            </Grid>
            <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="14" TextElement.FontWeight="SemiBold"/>
           </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsChecked" Value="False"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Fill" Value="#E5F1FB"/><Setter TargetName="Circle" Property="Stroke" Value="#0078D7"/></Trigger>
           <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bar" Property="Background" Value="#E5F1FB"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,4,0,0"/>
      </DockPanel>
      <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <DockPanel Margin="12">
  <Border DockPanel.Dock="Top" Background="#E4EFF6" Padding="10" Margin="0,0,0,10"><TextBlock x:Name="Target" TextWrapping="Wrap"/></Border>
  <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
   <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh" Padding="12,5"/>
   <Button x:Name="CancelRefreshButton" Content="Cancel Refresh" Click="CancelRefresh" Padding="12,5" Margin="8,0,0,0" Visibility="Collapsed" AutomationProperties.Name="Cancel activity refresh"/>
   <CheckBox x:Name="AutoRefreshCheck" Content="Auto-refresh" VerticalAlignment="Center" Margin="16,0,4,0" Checked="AutoRefreshChanged" Unchecked="AutoRefreshChanged"/>
   <ComboBox x:Name="AutoRefreshIntervalSelector" Width="90" SelectedIndex="3" SelectionChanged="AutoRefreshIntervalChanged" AutomationProperties.Name="Auto-refresh interval"><ComboBoxItem Content="1 sec" Tag="1"/><ComboBoxItem Content="3 sec" Tag="3"/><ComboBoxItem Content="5 sec" Tag="5"/><ComboBoxItem Content="10 sec" Tag="10"/><ComboBoxItem Content="15 sec" Tag="15"/><ComboBoxItem Content="30 sec" Tag="30"/><ComboBoxItem Content="1 min" Tag="60"/><ComboBoxItem Content="5 min" Tag="300"/><ComboBoxItem Content="30 min" Tag="1800"/><ComboBoxItem Content="1 hour" Tag="3600"/></ComboBox>
  </WrapPanel>
  <TextBox x:Name="Status" DockPanel.Dock="Bottom" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,8,0,0" Height="48" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Activity Monitor status"/>
  <ScrollViewer x:Name="Panels" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
   <StackPanel>
    <Expander x:Name="OverviewPanel" Header="Overview" IsExpanded="True" Margin="0,0,0,6">
     <StackPanel x:Name="OverviewArea" Margin="0,6,0,0" Background="Transparent" ContextMenuOpening="OverviewMenuOpening">
      <StackPanel.ContextMenu>
       <ContextMenu x:Name="OverviewMenu">
        <MenuItem x:Name="RefreshIntervalMenu" Header="Refresh _interval"/>
        <Separator/>
        <MenuItem x:Name="PauseMenu" Header="_Pause" Click="PauseAutoRefresh"/>
        <MenuItem x:Name="ResumeMenu" Header="Res_ume" Click="ResumeAutoRefresh"/>
        <Separator/>
        <MenuItem x:Name="RefreshMenu" Header="_Refresh" Click="Refresh"/>
       </ContextMenu>
      </StackPanel.ContextMenu>
      <UniformGrid x:Name="Charts" Columns="4">
       <StackPanel Margin="0,0,8,0"><TextBlock x:Name="ActiveSessionsTitle" Style="{StaticResource ChartTitle}"/><local:ActivityChart x:Name="ActiveSessionsChart" Height="110" ToolTip="Client sessions running a statement (pg_stat_activity state = active)"/></StackPanel>
       <StackPanel Margin="0,0,8,0"><TextBlock x:Name="WaitingSessionsTitle" Style="{StaticResource ChartTitle}"/><local:ActivityChart x:Name="WaitingSessionsChart" Height="110" ToolTip="Active client sessions waiting on an event (wait_event_type is set); pg_sleep, a requested pause like WAITFOR, is not counted"/></StackPanel>
       <StackPanel Margin="0,0,8,0"><TextBlock x:Name="DatabaseIoTitle" Style="{StaticResource ChartTitle}"/><local:ActivityChart x:Name="DatabaseIoChart" Height="110"/></StackPanel>
       <StackPanel><TextBlock x:Name="TransactionsTitle" Style="{StaticResource ChartTitle}"/><local:ActivityChart x:Name="TransactionsChart" Height="110" ToolTip="Commits plus rollbacks per second in all databases (pg_stat_database); includes the monitor's own reads"/></StackPanel>
      </UniformGrid>
      <TextBlock x:Name="OverviewNote" Style="{StaticResource PanelNote}"/>
     </StackPanel>
    </Expander>
    <Expander x:Name="ProcessesPanel" Header="Processes" IsExpanded="True" Margin="0,0,0,6">
     <DockPanel Margin="0,6,0,0">
      <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
       <Button x:Name="CancelButton" Content="Cancel Query" Click="CancelQuery" Padding="12,5" Margin="0,0,8,0" IsEnabled="False"/>
       <Button x:Name="TerminateButton" Content="Terminate Session…" Click="Terminate" Padding="12,5" IsEnabled="False"/>
       <Button x:Name="FirstPageButton" Content="First Page" Click="FirstPage" Padding="10,5" Margin="24,0,0,0" IsEnabled="False" AutomationProperties.Name="First page of sessions"/>
       <Button x:Name="PreviousPageButton" Content="Previous Page" Click="PreviousPage" Padding="10,5" Margin="8,0,0,0" IsEnabled="False" AutomationProperties.Name="Previous page of sessions"/>
       <Button x:Name="NextPageButton" Content="Next Page" Click="NextPage" Padding="10,5" Margin="8,0,0,0" IsEnabled="False" AutomationProperties.Name="Next page of sessions"/>
       <TextBlock x:Name="PageInfo" VerticalAlignment="Center" Margin="10,0,0,0" AutomationProperties.Name="Session page position"/>
      </WrapPanel>
      <Grid x:Name="FilterFields" DockPanel.Dock="Top" Margin="0,0,0,8">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
       <StackPanel><Label Content="Database contains:" Padding="0,0,0,2"/><TextBox x:Name="DatabaseFilter" AutomationProperties.Name="Database contains" Padding="3"/></StackPanel>
       <StackPanel Grid.Column="2"><Label Content="User contains:" Padding="0,0,0,2"/><TextBox x:Name="UserFilter" AutomationProperties.Name="User contains" Padding="3"/></StackPanel>
       <StackPanel Grid.Column="4"><Label Content="Application contains:" Padding="0,0,0,2"/><TextBox x:Name="ApplicationFilter" AutomationProperties.Name="Application contains" Padding="3"/></StackPanel>
       <StackPanel Grid.Column="6"><Label Content="PID:" Padding="0,0,0,2"/><TextBox x:Name="PidFilter" AutomationProperties.Name="Exact session PID" Padding="3"/></StackPanel>
       <WrapPanel Grid.Row="1" Grid.ColumnSpan="7" Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
        <TextBlock Text="State:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="StateFilter" AutomationProperties.Name="Session state" Width="180" SelectedIndex="0"><ComboBoxItem Content="All states"/><ComboBoxItem Content="active"/><ComboBoxItem Content="idle"/><ComboBoxItem Content="idle in transaction"/><ComboBoxItem Content="idle in transaction (aborted)"/><ComboBoxItem Content="fastpath function call"/><ComboBoxItem Content="disabled"/></ComboBox>
        <CheckBox x:Name="BlockedOnlyFilter" Content="Blocked only" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.Name="Only sessions waiting for a lock"/>
        <Button x:Name="ApplyFiltersButton" Content="Apply Filters" Click="ApplyFilters" Padding="12,4" Margin="8,0,0,0"/>
       </WrapPanel>
      </Grid>
      <TextBlock DockPanel.Dock="Top" Text="Ages use server snapshot time (days.hours:minutes:seconds). — means unavailable or not applicable." TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBox DockPanel.Dock="Bottom" Text="{Binding SelectedItem.Query, ElementName=Sessions}" IsReadOnly="True" FontFamily="Consolas" Height="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" AutomationProperties.Name="Selected session SQL"/>
      <DataGrid local:DataGridRowNames.Enabled="True" x:Name="Sessions" Height="300" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="SelectionChanged" EnableRowVirtualization="True" AutomationProperties.Name="Server sessions" PreviewMouseRightButtonDown="SelectRowUnderPointer" ContextMenuOpening="SessionMenuOpening" MouseDoubleClick="SessionDoubleClick">
       <DataGrid.ContextMenu>
        <ContextMenu>
         <MenuItem x:Name="DetailsMenu" Header="_Details…" Click="ShowDetails"/>
         <Separator/>
         <MenuItem x:Name="CancelQueryMenu" Header="_Cancel Query" Click="CancelQuery"/>
         <MenuItem x:Name="TerminateMenu" Header="_Terminate Session…" Click="Terminate"/>
        </ContextMenu>
       </DataGrid.ContextMenu>
       <DataGrid.Columns>
        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/><DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="95"/><DataGridTextColumn Header="User" Binding="{Binding User}" Width="85"/>
        <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="110"/><DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="90"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="120"/><DataGridTextColumn Header="Query age" Binding="{Binding QueryAge}" SortMemberPath="QueryDuration" Width="85"/><DataGridTextColumn Header="Transaction age" Binding="{Binding TransactionAge}" SortMemberPath="TransactionDuration" Width="105"/><DataGridTextColumn Header="Wait" Binding="{Binding Wait}" Width="110"/><DataGridTextColumn Header="Blocked by PID" Binding="{Binding Blockers}" Width="100"/><DataGridTextColumn Header="Head blocker" Binding="{Binding HeadBlocker}" SortMemberPath="IsHeadBlocker" Width="85"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Expander>
    <Expander x:Name="ResourceWaitsPanel" Header="Resource Waits" Margin="0,0,0,6">
     <StackPanel>
      <DataGrid local:DataGridRowNames.Enabled="True" x:Name="ResourceWaits" Style="{StaticResource PanelGrid}" AutomationProperties.Name="Resource waits">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Wait Category" Binding="{Binding Category}" Width="120"/><DataGridTextColumn Header="Wait Time (ms/sec)" Binding="{Binding WaitMsPerSecond, StringFormat=N0}" Width="130"/><DataGridTextColumn Header="Recent Wait Time (ms/sec)" Binding="{Binding RecentWaitMsPerSecond, StringFormat=N0}" Width="170"/><DataGridTextColumn Header="Average Waiter Count" Binding="{Binding AverageWaiters, StringFormat=N2}" Width="145"/><DataGridTextColumn Header="Cumulative Wait Time (sec)" Binding="{Binding CumulativeWaitSeconds, StringFormat=N1}" Width="175"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="ResourceWaitsNote" Style="{StaticResource PanelNote}" Text="Sampled at each refresh: PostgreSQL keeps no cumulative wait time, so each backend seen waiting counts for the whole second or interval. Idle Activity waits, idle client sessions and pg_sleep (a requested pause, like WAITFOR) are left out; wait events of other roles' sessions may be hidden without pg_read_all_stats."/>
     </StackPanel>
    </Expander>
    <Expander x:Name="DataFileIoPanel" Header="Data File I/O" Margin="0,0,0,6">
     <StackPanel>
      <DataGrid local:DataGridRowNames.Enabled="True" x:Name="DataFileIo" Style="{StaticResource PanelGrid}" AutomationProperties.Name="Data file I/O by database">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="180"/><DataGridTextColumn Header="MB/sec Read" Binding="{Binding ReadMegabytesPerSecond, StringFormat=N2, TargetNullValue=—}" Width="110"/><DataGridTextColumn Header="Temp MB/sec Written" Binding="{Binding TempMegabytesPerSecond, StringFormat=N2, TargetNullValue=—}" Width="145"/><DataGridTextColumn Header="Average Read Time (ms)" Binding="{Binding AverageReadMs, StringFormat=N2, TargetNullValue=—}" Width="160"/><DataGridTextColumn Header="Buffer Hit %" Binding="{Binding HitRatio, StringFormat=P1, TargetNullValue=—}" Width="100"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="DataFileIoNote" Style="{StaticResource PanelNote}" Text="Per database between the last two refreshes (pg_stat_database). PostgreSQL has no per-file statistics and does not attribute data file writes to a database; Average Read Time needs track_io_timing."/>
     </StackPanel>
    </Expander>
    <Expander x:Name="RecentQueriesPanel" Header="Recent Expensive Queries" Margin="0,0,0,6" Expanded="PanelExpanded" Collapsed="RecentQueriesCollapsed">
     <StackPanel>
      <DataGrid local:DataGridRowNames.Enabled="True" x:Name="RecentQueries" Style="{StaticResource PanelGrid}" AutomationProperties.Name="Recent expensive queries">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Query" Binding="{Binding QueryLine}" ElementStyle="{StaticResource QueryCell}" SortMemberPath="Query" Width="260"/><DataGridTextColumn Header="Executions/min" Binding="{Binding ExecutionsPerMinute, StringFormat=N1}" Width="105"/><DataGridTextColumn Header="Execution (ms/sec)" Binding="{Binding ExecutionMsPerSecond, StringFormat=N1}" Width="125"/><DataGridTextColumn Header="Physical Reads/sec" Binding="{Binding PhysicalReadsPerSecond, StringFormat=N1}" Width="125"/><DataGridTextColumn Header="Logical Reads/sec" Binding="{Binding LogicalReadsPerSecond, StringFormat=N1}" Width="120"/><DataGridTextColumn Header="Average Duration (ms)" Binding="{Binding AverageDurationMs, StringFormat=N3}" Width="145"/><DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="110"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="RecentQueriesNote" Style="{StaticResource PanelNote}"/>
     </StackPanel>
    </Expander>
    <Expander x:Name="ActiveQueriesPanel" Header="Active Expensive Queries" Expanded="PanelExpanded">
     <StackPanel>
      <DataGrid local:DataGridRowNames.Enabled="True" x:Name="ActiveQueries" Style="{StaticResource PanelGrid}" AutomationProperties.Name="Active expensive queries" PreviewMouseRightButtonDown="SelectActiveQueryUnderPointer" ContextMenuOpening="ActiveQueryMenuOpening">
       <DataGrid.ContextMenu>
        <ContextMenu>
         <MenuItem x:Name="EditQueryTextMenu" Header="_Edit Query Text" Click="EditQueryText"/>
         <Separator/>
         <MenuItem x:Name="ShowPlanMenu" Header="Show Execution _Plan" Click="ShowQueryPlan"/>
        </ContextMenu>
       </DataGrid.ContextMenu>
       <DataGrid.Columns>
        <DataGridTextColumn Header="Query" Binding="{Binding QueryLine}" ElementStyle="{StaticResource QueryCell}" SortMemberPath="Query" Width="360"/><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/><DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="110"/><DataGridTextColumn Header="User" Binding="{Binding User}" Width="100"/><DataGridTextColumn Header="Elapsed" Binding="{Binding ElapsedLabel}" SortMemberPath="Elapsed" Width="90"/><DataGridTextColumn Header="Wait" Binding="{Binding Wait}" Width="130"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="ActiveQueriesNote" Style="{StaticResource PanelNote}"/>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</UserControl>
