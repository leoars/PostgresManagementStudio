<Window x:Class="PGMS.Desktop.ExpressionIndexDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Expression Index" Width="900" Height="820" MinWidth="780" MinHeight="670" Background="#F5F5F5" WindowStartupLocation="CenterOwner" Closing="OnClosing">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="190"/><RowDefinition MinHeight="100"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#E4EFF6" Padding="10" Margin="0,0,0,10"><TextBlock x:Name="Target" TextWrapping="Wrap"/></Border>
  <ScrollViewer x:Name="FormScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Fields">
   <Label Content="Index _name:" Target="{Binding ElementName=IndexName}"/><TextBox x:Name="IndexName" TextChanged="Changed" Padding="4" AutomationProperties.Name="Expression index name"/>
   <DataGrid x:Name="KeysGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="100" AutomationProperties.Name="Ordered expression index keys"><DataGrid.Columns><DataGridTextColumn Header="Column" Binding="{Binding Expression.Column}" Width="*"/><DataGridTextColumn Header="Expression" Binding="{Binding Expression.Transform}" Width="100"/><DataGridTextColumn Header="Order" Binding="{Binding Order}" Width="90"/><DataGridTextColumn Header="NULLs" Binding="{Binding Nulls}" Width="75"/><DataGridTextColumn Header="Operator class" Binding="{Binding OperatorClass.Name,TargetNullValue=Server default,FallbackValue=Server default}" Width="150"/></DataGrid.Columns></DataGrid>
   <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Label Content="_Column:" Target="{Binding ElementName=Column}"/><ComboBox x:Name="Column" SelectionChanged="KeyChanged" AutomationProperties.Name="Index source column"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><Label Content="_Expression:" Target="{Binding ElementName=Transform}"/><ComboBox x:Name="Transform" SelectionChanged="KeyChanged" AutomationProperties.Name="Index expression transform"/></StackPanel><StackPanel Grid.Column="2"><Label Content="Order:" Target="{Binding ElementName=Sort}"/><ComboBox x:Name="Sort" AutomationProperties.Name="Key direction"/></StackPanel><StackPanel Grid.Column="3" Margin="8,0,0,0"><Label Content="NULLs:" Target="{Binding ElementName=NullOrder}"/><ComboBox x:Name="NullOrder" AutomationProperties.Name="Key NULL placement"/></StackPanel></Grid>
   <DockPanel><Label Content="Operator class:" Target="{Binding ElementName=Opclass}"/><ComboBox x:Name="Opclass" DisplayMemberPath="Label" AutomationProperties.Name="Inspected compatible operator class"/></DockPanel>
   <StackPanel Orientation="Horizontal" Margin="0,6"><Button x:Name="AddKeyButton" Content="Add key" Click="AddKey" Padding="10,3"/><Button Content="Remove key" Click="RemoveKey" Padding="10,3" Margin="8,0"/><Button Content="Move up" Click="MoveKey" Padding="10,3"/></StackPanel>
   <Label Content="INCLUDE columns, one exact name per line:" Target="{Binding ElementName=Included}"/><TextBox x:Name="Included" Height="55" AcceptsReturn="True" TextChanged="Changed" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Included index columns"/>
   <StackPanel Orientation="Horizontal" Margin="0,6"><CheckBox x:Name="Unique" Content="Unique" Checked="Changed" Unchecked="Changed"/><CheckBox x:Name="NullsEqual" Content="Treat NULLs as equal" Checked="Changed" Unchecked="Changed" Margin="18,0"/></StackPanel>
   <CheckBox x:Name="UsePredicate" Content="Partial index (only rows matching a predicate)" Checked="Changed" Unchecked="Changed" Margin="0,6"/>
   <StackPanel x:Name="PredicateFields"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Label Content="Predicate column:" Target="{Binding ElementName=PredicateColumn}"/><ComboBox x:Name="PredicateColumn" SelectionChanged="Changed" AutomationProperties.Name="Predicate column"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><Label Content="Transform:" Target="{Binding ElementName=PredicateTransform}"/><ComboBox x:Name="PredicateTransform" SelectionChanged="Changed" AutomationProperties.Name="Predicate transform"/></StackPanel><StackPanel Grid.Column="2"><Label Content="Comparison:" Target="{Binding ElementName=Comparison}"/><ComboBox x:Name="Comparison" SelectionChanged="Changed" AutomationProperties.Name="Predicate comparison"/></StackPanel></Grid><Label Content="Literal value (quoted as text):" Target="{Binding ElementName=PredicateValue}"/><TextBox x:Name="PredicateValue" TextChanged="Changed" Padding="4" AutomationProperties.Name="Predicate literal value"/></StackPanel>
   <TextBlock Text="Built-in column, lower, upper, length and absolute expressions. B-tree only; standard creation blocks writes. Add keys in order, then review SQL. Exported scripts resolve names when executed." TextWrapping="Wrap" Margin="0,8"/>
  </StackPanel></ScrollViewer>
  <TextBox x:Name="Preview" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" AutomationProperties.Name="Expression index SQL preview"/>
  <TextBlock x:Name="Feedback" Grid.Row="3" TextWrapping="Wrap" Margin="0,8"/>
  <DockPanel Grid.Row="4" LastChildFill="False"><Button x:Name="InspectButton" Content="_Inspect" Click="Inspect" Padding="12,5"/><Button x:Name="CancelButton" Content="Cancel operation" Click="Cancel" Visibility="Collapsed" Margin="8,0" Padding="12,5"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="MaintainButton" Content="Maintain…" Click="Maintain" Padding="10,5" Margin="0,0,8,0"/><Button x:Name="ConcurrentButton" Content="Concurrent…" Click="Concurrent" Padding="10,5" Margin="0,0,8,0"/><Button x:Name="ScriptButton" Content="_Script" Click="Script" Padding="12,5"/><Button x:Name="ApplyButton" Content="_Create" Click="Apply" Padding="12,5" Margin="8,0"/><Button x:Name="CloseButton" Content="Close" IsCancel="True" Padding="12,5"/></StackPanel></DockPanel>
 </Grid>
</Window>
