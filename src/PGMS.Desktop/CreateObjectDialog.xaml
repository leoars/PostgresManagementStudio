<Window x:Class="PGMS.Desktop.CreateObjectDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="New Database" Width="730" Height="540" MinWidth="650" MinHeight="500"
 Background="#F5F5F5" WindowStartupLocation="CenterOwner" Closing="DialogClosing">
 <Grid Margin="12">
  <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#B5C5D2" BorderThickness="1"><StackPanel><TextBlock Text="Select a page" FontWeight="SemiBold" Margin="9"/><Border Background="#D5E5EF" Padding="10,6"><TextBlock Text="General"/></Border></StackPanel></Border>
  <Grid Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="#E4EFF6" Padding="10" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="Heading" Text="New Database" FontSize="18"/><TextBlock x:Name="Target" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
   <Grid Grid.Row="1" x:Name="Fields">
    <Grid.ColumnDefinitions><ColumnDefinition Width="114"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Label Content="_Name:" Target="{Binding ElementName=ObjectName}"/><TextBox x:Name="ObjectName" Grid.Column="1" Height="25" VerticalAlignment="Top" Padding="4,2" TextChanged="InputChanged"/>
    <Label Grid.Row="1" Content="_Owner:" Target="{Binding ElementName=OwnerName}"/><TextBox x:Name="OwnerName" Grid.Row="1" Grid.Column="1" Height="25" VerticalAlignment="Top" Padding="4,2" TextChanged="InputChanged" ToolTip="Leave blank to use the connected role"/>
   </Grid>
   <TextBlock Grid.Row="2" Text="Leave Owner blank to use the connected role." Foreground="#4B5964" Margin="0,2,0,10"/>
   <TextBlock Grid.Row="3" Text="SQL preview" FontWeight="SemiBold" Margin="0,0,0,5"/>
   <TextBox Grid.Row="4" x:Name="SqlPreview" IsReadOnly="True" FontFamily="Consolas" FontSize="13" Background="White" BorderBrush="#B5C5D2" Padding="8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="SQL preview"/>
   <TextBlock Grid.Row="5" x:Name="Feedback" TextWrapping="Wrap" Foreground="#A4262C" Margin="0,10,0,4"/>
  </Grid>
  <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
   <TextBlock x:Name="Progress" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="ScriptButton" Content="_Script" Click="Script" Width="85" Margin="0,0,8,0" Padding="5" IsEnabled="False" ToolTip="Open this SQL in a query tab without executing"/>
    <Button x:Name="CreateButton" Content="_Create" Click="Create" Width="85" Margin="0,0,8,0" Padding="5" IsEnabled="False"/>
    <Button x:Name="CancelButton" Content="Cancel" Width="85" Padding="5" IsCancel="True"/>
   </StackPanel>
  </DockPanel>
 </Grid>
</Window>
