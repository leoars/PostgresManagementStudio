<Window x:Class="PGMS.Desktop.DatabaseEditDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Database Operations" Width="720" Height="540" MinWidth="640" MinHeight="500" Background="#F5F5F5" WindowStartupLocation="CenterOwner" Closing="OnClosing">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#E4EFF6" Padding="10" Margin="0,0,0,10"><TextBlock x:Name="Target" TextWrapping="Wrap"/></Border>
  <StackPanel x:Name="Fields" Grid.Row="1"><Label Content="Operation:"/><ComboBox x:Name="Operation" SelectionChanged="Changed" Padding="4"/><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Label Content="Database name (exact):"/><TextBox x:Name="DatabaseName" Padding="4" TextChanged="Changed"/></StackPanel><Button x:Name="InspectButton" Grid.Column="2" Content="Inspect server databases" Click="Inspect" VerticalAlignment="Bottom" Padding="12,5"/></Grid><StackPanel x:Name="RenameFields"><Label Content="New database name (rename only):"/><TextBox x:Name="NewName" Padding="4" TextChanged="Changed"/></StackPanel></StackPanel>
  <TextBlock Grid.Row="2" Text="Rename and DROP run outside a transaction through the postgres maintenance database. DROP does not force-close sessions; PostgreSQL will refuse while connections remain. System/template databases are protected." TextWrapping="Wrap" Margin="0,10"/>
  <TextBox Grid.Row="3" x:Name="Preview" IsReadOnly="True" FontFamily="Consolas" Padding="8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="SQL preview"/>
  <TextBlock Grid.Row="4" x:Name="Feedback" TextWrapping="Wrap" Margin="0,8"/>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ScriptButton" Content="Script" Click="Script" Padding="16,5"/><Button x:Name="ApplyButton" Content="Apply" Click="Apply" Padding="16,5" Margin="8,0"/><Button x:Name="CloseButton" Content="Close" IsCancel="True" Padding="16,5"/></StackPanel>
 </Grid>
</Window>
