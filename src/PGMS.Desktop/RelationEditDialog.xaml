<Window x:Class="PGMS.Desktop.RelationEditDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Index Operations" Width="780" Height="800" MinWidth="700" MinHeight="760" Background="#F5F5F5" WindowStartupLocation="CenterOwner" Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="110"/><RowDefinition Height="*" MinHeight="72"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#E4EFF6" Padding="10" Margin="0,0,0,10"><TextBlock x:Name="Target" TextWrapping="Wrap"/></Border>
  <ScrollViewer Grid.Row="1" MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Fields">
   <Label Content="_Operation:" Target="{Binding ElementName=Operation}"/><ComboBox x:Name="Operation" SelectionChanged="Changed" Padding="4" AutomationProperties.Name="Operation"/>
   <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Label Content="Sc_hema:" Target="{Binding ElementName=SchemaName}"/><TextBox x:Name="SchemaName" Padding="4" TextChanged="Changed" AutomationProperties.Name="Schema"/></StackPanel><StackPanel Grid.Column="2"><Label Content="_Table:" Target="{Binding ElementName=TableName}"/><TextBox x:Name="TableName" Padding="4" TextChanged="Changed" AutomationProperties.Name="Table"/></StackPanel></Grid>
   <Label Content="Index _name:" x:Name="NameLabel" Target="{Binding ElementName=ObjectName}"/><TextBox x:Name="ObjectName" Padding="4" TextChanged="Changed" AutomationProperties.Name="Index name"/>
   <StackPanel x:Name="CreateFields"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Label Content="Columns, one exact name per line (no quoting):" Target="{Binding ElementName=Columns}"/><TextBox x:Name="Columns" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="4" TextChanged="Changed" AutomationProperties.Name="Columns, one exact name per line (no quoting)"/>
   </StackPanel><StackPanel Grid.Column="2"><Label Content="INCLUDE columns (optional, one per line):" Target="{Binding ElementName=IncludedColumns}"/><TextBox x:Name="IncludedColumns" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="4" TextChanged="Changed" AutomationProperties.Name="INCLUDE columns (optional, one per line)"/></StackPanel></Grid><StackPanel Orientation="Horizontal"><CheckBox x:Name="Unique" Content="Unique index" Margin="0,8" Checked="Changed" Unchecked="Changed"/><CheckBox x:Name="NullsNotDistinct" Content="Treat NULLs as equal (PostgreSQL 15+)" Margin="20,8,0,8" Checked="Changed" Unchecked="Changed"/></StackPanel><StackPanel Orientation="Horizontal"><Label Content="Method:" Target="{Binding ElementName=Method}"/><ComboBox x:Name="Method" Width="95" Padding="4" Margin="0,0,12,0" SelectionChanged="Changed" AutomationProperties.Name="Method"/><Label Content="Fillfactor (10-100; blank = server default):" Target="{Binding ElementName=FillFactor}"/><TextBox x:Name="FillFactor" Width="65" Padding="4" TextChanged="Changed" AutomationProperties.Name="Fillfactor (10-100; blank = server default)"/></StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Label Content="All key columns:" Target="{Binding ElementName=SortOrder}"/><ComboBox x:Name="SortOrder" Width="125" Padding="4" SelectionChanged="Changed" AutomationProperties.Name="All key columns"/><Label Content="NULL position:" Margin="12,0,0,0" Target="{Binding ElementName=NullPlacement}"/><ComboBox x:Name="NullPlacement" Width="95" Padding="4" SelectionChanged="Changed" ToolTip="Default: LAST for ascending keys; FIRST for descending keys." AutomationProperties.Name="NULL position"/></StackPanel></StackPanel>
  </StackPanel></ScrollViewer>
  <GroupBox Grid.Row="2" Margin="0,8,0,0"><GroupBox.Header><StackPanel Orientation="Horizontal"><TextBlock Text="Existing indexes" VerticalAlignment="Center"/><Button x:Name="InspectButton" Content="_Inspect table indexes" Click="Inspect" Padding="8,2" Margin="12,0,0,0"/></StackPanel></GroupBox.Header><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><ListBox x:Name="ExistingIndexes" DisplayMemberPath="Summary" SelectionChanged="IndexSelected" AutomationProperties.Name="Existing indexes"/><TextBox x:Name="IndexDefinition" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected index definition"/></Grid></GroupBox>
  <TextBox Grid.Row="3" x:Name="Preview" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" Margin="0,8,0,0" AutomationProperties.Name="SQL preview"/>
  <TextBlock Grid.Row="4" x:Name="Feedback" TextWrapping="Wrap" Margin="0,8"/>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelInspectionButton" Content="Cancel Ins_pection" Click="CancelInspection" IsEnabled="False" Padding="12,5" Margin="0,0,12,0"/><Button x:Name="ScriptButton" Content="_Script" Click="Script" Padding="16,5"/><Button x:Name="ApplyButton" Content="_Apply" Click="Apply" Padding="16,5" Margin="8,0"/><Button x:Name="CloseButton" Content="_Close" IsCancel="True" Padding="16,5"/></StackPanel>
 </Grid>
</Window>
