<Window x:Class="PGMS.Desktop.ForeignKeyDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Foreign Key Operations" Width="820" Height="790" MinWidth="740" MinHeight="720" Background="#F5F5F5" WindowStartupLocation="CenterOwner" Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="72" MaxHeight="130"/><RowDefinition Height="2*" MinHeight="72"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#E4EFF6" Padding="10" Margin="0,0,0,10"><TextBlock x:Name="Target" TextWrapping="Wrap"/></Border>
  <StackPanel x:Name="Fields" Grid.Row="1">
   <Label Content="_Operation:" Target="{Binding ElementName=Operation}"/><ComboBox x:Name="Operation" SelectionChanged="Changed" Padding="4" AutomationProperties.Name="Operation"/>
   <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Label Content="Sc_hema:" Target="{Binding ElementName=SchemaName}"/><TextBox x:Name="SchemaName" Padding="4" TextChanged="Changed" AutomationProperties.Name="Schema"/></StackPanel><StackPanel Grid.Column="2"><Label Content="_Table:" Target="{Binding ElementName=TableName}"/><TextBox x:Name="TableName" Padding="4" TextChanged="Changed" AutomationProperties.Name="Table"/></StackPanel></Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Label Content="Constraint _name:" Target="{Binding ElementName=ObjectName}"/><TextBox x:Name="ObjectName" Padding="4" TextChanged="Changed" AutomationProperties.Name="Constraint name"/></StackPanel><Button x:Name="InspectButton" Grid.Column="2" Content="_Inspect" Click="Inspect" VerticalAlignment="Bottom" Padding="14,5" Margin="0,0,0,2"/></Grid>
   <Grid x:Name="CreateFields" Margin="0,6"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Label Content="Local columns, one exact name per line:" Target="{Binding ElementName=Columns}"/><TextBox x:Name="Columns" Height="60" AcceptsReturn="True" TextChanged="Changed" AutomationProperties.Name="Local columns, one exact name per line"/></StackPanel><StackPanel Grid.Column="2"><Label Content="Referenced columns, same order:" Target="{Binding ElementName=ReferencedColumns}"/><TextBox x:Name="ReferencedColumns" Height="60" AcceptsReturn="True" TextChanged="Changed" AutomationProperties.Name="Referenced columns, same order"/></StackPanel><StackPanel Grid.Row="1"><Label Content="Referenced schema:" Target="{Binding ElementName=ReferencedSchema}"/><TextBox x:Name="ReferencedSchema" Padding="4" TextChanged="Changed" AutomationProperties.Name="Referenced schema"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2"><Label Content="Referenced table:" Target="{Binding ElementName=ReferencedTable}"/><TextBox x:Name="ReferencedTable" Padding="4" TextChanged="Changed" AutomationProperties.Name="Referenced table"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal"><StackPanel><Label Content="On update:" Target="{Binding ElementName=OnUpdate}"/><ComboBox x:Name="OnUpdate" Width="170" SelectionChanged="Changed" AutomationProperties.Name="On update"/></StackPanel><StackPanel Margin="12,0,0,0"><Label Content="On delete:" Target="{Binding ElementName=OnDelete}"/><ComboBox x:Name="OnDelete" Width="170" SelectionChanged="Changed" AutomationProperties.Name="On delete"/></StackPanel></StackPanel></Grid>
   <CheckBox x:Name="NotValid" Content="Skip existing rows (NOT VALID)" Margin="0,6,0,0" Checked="Changed" Unchecked="Changed"/>
  </StackPanel>
  <GroupBox Grid.Row="2" Header="Existing FOREIGN KEY constraints" Margin="0,8,0,0"><ListBox x:Name="ExistingConstraints" SelectionChanged="ConstraintSelected" DisplayMemberPath="Summary" AutomationProperties.Name="Existing constraints"/></GroupBox>
  <TextBox Grid.Row="3" x:Name="Preview" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" Margin="0,8,0,0" AutomationProperties.Name="SQL preview"/>
  <TextBlock Grid.Row="4" x:Name="Feedback" TextWrapping="Wrap" Margin="0,8"/>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelInspectionButton" Content="Cancel Ins_pection" Click="CancelInspection" IsEnabled="False" Padding="12,5" Margin="0,0,12,0"/><Button x:Name="ScriptButton" Content="_Script" Click="Script" Padding="16,5"/><Button x:Name="ApplyButton" Content="_Apply" Click="Apply" Padding="16,5" Margin="8,0"/><Button x:Name="CloseButton" Content="_Close" IsCancel="True" Padding="16,5"/></StackPanel>
 </Grid>
</Window>
