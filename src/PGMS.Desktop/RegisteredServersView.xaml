<UserControl x:Class="PGMS.Desktop.RegisteredServersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PGMS.Desktop" AutomationProperties.Name="Registered Servers">
 <DockPanel Background="{StaticResource PanelBrush}">
  <ToolBar DockPanel.Dock="Top">
   <Button Content="New Group…" Click="NewGroup" ToolTip="New Server Group in the selected group"/>
   <Button Content="Register…" Click="NewRegistration" ToolTip="New Server Registration in the selected group"/>
   <Separator/>
   <Button Content="Refresh" Click="Refresh"/>
  </ToolBar>
  <TextBlock x:Name="Feedback" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="5,3" AutomationProperties.LiveSetting="Polite"/>
  <TreeView x:Name="Tree" BorderThickness="0" Background="{StaticResource PanelBrush}" Padding="5" AutomationProperties.Name="Registered Servers Hierarchy"
            ContextMenuOpening="MenuOpening" MouseDoubleClick="TreeDoubleClick" KeyDown="TreeKeyDown">
   <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem" BasedOn="{StaticResource SsmsTreeViewItem}"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/></Style></TreeView.ItemContainerStyle>
   <TreeView.ItemTemplate>
    <HierarchicalDataTemplate DataType="{x:Type local:RegisteredServerNode}" ItemsSource="{Binding Children}">
     <StackPanel Orientation="Horizontal" ToolTip="{Binding Detail}">
      <Image Width="16" Height="16" Margin="0,0,3,0" VerticalAlignment="Center" Source="{Binding Icon}" IsHitTestVisible="False" Focusable="False"/>
      <Border Style="{StaticResource SsmsTreeLabel}"><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></Border>
     </StackPanel>
    </HierarchicalDataTemplate>
   </TreeView.ItemTemplate>
   <TreeView.ContextMenu><ContextMenu x:Name="Menu"/></TreeView.ContextMenu>
  </TreeView>
 </DockPanel>
</UserControl>
