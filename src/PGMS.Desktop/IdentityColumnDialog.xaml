<Window x:Class="PGMS.Desktop.IdentityColumnDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Identity Column" Width="760" Height="720" MinWidth="650" MinHeight="600" Background="#F5F5F5" WindowStartupLocation="CenterOwner" Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="140"/><RowDefinition MinHeight="90"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#E4EFF6" Padding="10" Margin="0,0,0,10"><TextBlock x:Name="Target" TextWrapping="Wrap"/></Border>
  <ScrollViewer Grid.Row="1" x:Name="FormScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><StackPanel x:Name="Fields">
   <Label Content="Inspected identity:" Target="{Binding ElementName=Observation}"/><TextBox x:Name="Observation" IsReadOnly="True" Height="130" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6" AutomationProperties.Name="Inspected identity metadata"/>
   <Label Content="_Operation:" Target="{Binding ElementName=Operation}"/><ComboBox x:Name="Operation" SelectionChanged="Changed" Padding="4" AutomationProperties.Name="Identity operation"/>
   <StackPanel x:Name="RestartFields" Visibility="Collapsed"><Label Content="Explicit _restart value:" Target="{Binding ElementName=RestartValue}"/><TextBox x:Name="RestartValue" TextChanged="Changed" Padding="4" MaxLength="24" AutomationProperties.Name="Explicit identity restart value"/></StackPanel>
   <StackPanel x:Name="ParameterFields" Visibility="Collapsed"><Label x:Name="ParameterLabel" Content="_Value:" Target="{Binding ElementName=ParameterValue}"/><TextBox x:Name="ParameterValue" TextChanged="Changed" Padding="4" MaxLength="24" AutomationProperties.Name="Identity sequence parameter value"/></StackPanel>
   <StackPanel x:Name="MaximumFields" Visibility="Collapsed"><Label Content="_Maximum:" Target="{Binding ElementName=MaximumValue}"/><TextBox x:Name="MaximumValue" TextChanged="Changed" Padding="4" MaxLength="24" AutomationProperties.Name="Identity sequence maximum value"/></StackPanel>
   <CheckBox x:Name="CycleValue" Content="_Cycle at bounds" Visibility="Collapsed" Checked="Changed" Unchecked="Changed" Margin="0,8" AutomationProperties.Name="Identity sequence cycle"/>
   <Button x:Name="LoadConfiguredButton" Content="_Load configured value" Click="LoadConfigured" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,6" Padding="8,4" AutomationProperties.Name="Load inspected identity sequence configuration"/>
   <TextBlock x:Name="OperationHelp" TextWrapping="Wrap" Margin="0,8" AutomationProperties.Name="Identity operation guidance"/>
  </StackPanel></ScrollViewer>
  <TextBox Grid.Row="2" x:Name="Preview" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" AutomationProperties.Name="Identity SQL preview"/>
  <TextBlock Grid.Row="3" x:Name="Feedback" Text="Inspect the selected column before preparing an identity change." TextWrapping="Wrap" Margin="0,8"/>
  <DockPanel Grid.Row="4" LastChildFill="False">
   <Button x:Name="InspectButton" Content="_Inspect" Click="Inspect" Padding="12,5" AutomationProperties.Name="Inspect selected identity column"/>
   <Button x:Name="CancelButton" Content="_Cancel operation" Click="Cancel" Visibility="Collapsed" Margin="8,0,0,0" Padding="12,5" AutomationProperties.Name="Cancel identity operation"/>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ScriptButton" Content="_Script" Click="Script" IsEnabled="False" Padding="12,5"/><Button x:Name="ApplyButton" Content="_Apply" Click="Apply" IsEnabled="False" Margin="8,0" Padding="12,5"/><Button x:Name="CloseButton" Content="C_lose" IsCancel="True" Padding="12,5"/></StackPanel>
  </DockPanel>
 </Grid>
</Window>
