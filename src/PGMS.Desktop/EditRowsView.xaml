<UserControl x:Class="PGMS.Desktop.EditRowsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PGMS.Desktop">
 <DockPanel Background="White">
  <!-- SSMS 22.11 footer: |◀ ◀ [n] of N ▶ ▶| ▶* and a stop button (M1044). -->
  <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#D0D7DE" BorderThickness="0,1,0,0" Padding="4,2">
   <DockPanel>
    <StackPanel Orientation="Horizontal">
     <StackPanel.Resources>
      <Style TargetType="Button"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="20"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#1E6FC6"/><Setter Property="FontSize" Value="11"/></Style>
     </StackPanel.Resources>
     <Button x:Name="FirstButton" Content="|◀" Click="MoveFirst" ToolTip="Move first" AutomationProperties.Name="Move first"/>
     <Button x:Name="PreviousButton" Content="◀" Click="MovePrevious" ToolTip="Move previous" AutomationProperties.Name="Move previous"/>
     <TextBox x:Name="PositionBox" Width="54" Margin="4,0" VerticalContentAlignment="Center" KeyDown="PositionKeyDown" AutomationProperties.Name="Current row position"/>
     <TextBlock x:Name="CountText" Text="of 0" VerticalAlignment="Center" Margin="2,0,6,0"/>
     <Button x:Name="NextButton" Content="▶" Click="MoveNext" ToolTip="Move next" AutomationProperties.Name="Move next"/>
     <Button x:Name="LastButton" Content="▶|" Click="MoveLast" ToolTip="Move last" AutomationProperties.Name="Move last"/>
     <Button x:Name="NewRowButton" Content="▶*" Click="MoveNew" ToolTip="Move to a new row" AutomationProperties.Name="Move to a new row"/>
    </StackPanel>
    <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#3A3A3A"/>
   </DockPanel>
  </Border>
  <DataGrid x:Name="Rows" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
            SelectionUnit="CellOrRowHeader" SelectionMode="Extended" HeadersVisibility="All" GridLinesVisibility="All" RowHeaderWidth="20" RowHeight="22"
            HorizontalGridLinesBrush="#E3E3E3" VerticalGridLinesBrush="#E3E3E3" BorderThickness="0" FontFamily="Segoe UI" FontSize="12"
            EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Table rows"
            PreviewKeyDown="RowsPreviewKeyDown" CurrentCellChanged="CurrentCellMoved" RowEditEnding="RowEditEnding">
   <DataGrid.RowHeaderTemplate>
    <DataTemplate>
     <!-- ▶ current row, pencil while the row has uncommitted changes, * for the new row, ! when saving failed. -->
     <TextBlock FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#3A3A3A">
      <TextBlock.Text>
       <MultiBinding Converter="{x:Static local:EditRowGlyph.Instance}">
        <Binding Path="IsEditing" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
        <Binding Path="IsNewItem" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
        <Binding Path="Item" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
        <Binding Path="CurrentItem" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
       </MultiBinding>
      </TextBlock.Text>
     </TextBlock>
    </DataTemplate>
   </DataGrid.RowHeaderTemplate>
  </DataGrid>
 </DockPanel>
</UserControl>
