<Window x:Class="PGMS.Desktop.TablePropertiesDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Table Properties" Width="820" Height="650" MinWidth="700" MinHeight="550" Background="#F5F5F5" WindowStartupLocation="CenterOwner" Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#E4EFF6" Padding="10" Margin="0,0,0,10"><TextBlock x:Name="Target" TextWrapping="Wrap"/></Border>
  <Grid x:Name="Fields" Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><Label Content="Schema:" Target="{Binding ElementName=SchemaName}"/><TextBox x:Name="SchemaName" Padding="4" TextChanged="Changed"/></StackPanel>
   <StackPanel Grid.Column="2"><Label Content="Table:" Target="{Binding ElementName=TableName}"/><TextBox x:Name="TableName" Padding="4" TextChanged="Changed"/></StackPanel>
   <Button x:Name="InspectButton" Grid.Column="3" Content="Inspect" Click="Inspect" Padding="14,5" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
  </Grid>
  <TabControl x:Name="Details" Grid.Row="2"><TabItem Header="General"><TextBox x:Name="Summary" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" AutomationProperties.Name="Table properties"/></TabItem><TabItem Header="Columns"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="110"/></Grid.RowDefinitions>
   <DataGrid x:Name="ColumnsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="ColumnSelected" EnableRowVirtualization="True" HeadersVisibility="Column" AutomationProperties.Name="Table columns">
    <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Position}" Width="40"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="170"/><DataGridCheckBoxColumn Header="Nullable" Binding="{Binding Nullable}" Width="70"/><DataGridTextColumn Header="Identity" Binding="{Binding Identity}" Width="95"/><DataGridTextColumn Header="Generated" Binding="{Binding Generated}" Width="90"/></DataGrid.Columns>
   </DataGrid>
   <TextBox x:Name="ColumnDetail" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" AutomationProperties.Name="Selected column definition and comment"/>
  </Grid></TabItem><TabItem Header="Direct Dependents"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions>
   <TextBlock x:Name="DependencyNotice" TextWrapping="Wrap" Margin="8" Text="Inspect to read direct dependency entries."/>
   <DataGrid x:Name="DependentsGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="DependentSelected" EnableRowVirtualization="True" HeadersVisibility="Column" AutomationProperties.Name="Direct dependent objects">
    <DataGrid.Columns><DataGridTextColumn Header="Dependent object" Binding="{Binding Description}" Width="360"/><DataGridTextColumn Header="Referenced column" Binding="{Binding Reference}" Width="160"/><DataGridTextColumn Header="Dependency kind" Binding="{Binding Kind}" Width="140"/></DataGrid.Columns>
   </DataGrid>
   <TextBox x:Name="DependencyDetail" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" AutomationProperties.Name="Selected dependency description"/>
  </Grid></TabItem><TabItem Header="Indexes"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions>
   <TextBlock x:Name="IndexNotice" TextWrapping="Wrap" Margin="8" Text="Inspect to read indexes."/>
   <DataGrid x:Name="IndexesGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="IndexSelected" EnableRowVirtualization="True" HeadersVisibility="Column" AutomationProperties.Name="Table indexes">
    <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="230"/><DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="85"/><DataGridCheckBoxColumn Header="Unique" Binding="{Binding Unique}" Width="70"/><DataGridCheckBoxColumn Header="Primary" Binding="{Binding Primary}" Width="70"/><DataGridCheckBoxColumn Header="Valid" Binding="{Binding Valid}" Width="60"/><DataGridCheckBoxColumn Header="Ready" Binding="{Binding Ready}" Width="60"/></DataGrid.Columns>
   </DataGrid>
   <TextBox x:Name="IndexDetail" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" FontFamily="Consolas" AutomationProperties.Name="Selected index definition"/>
  </Grid></TabItem><TabItem Header="Constraints"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions>
   <TextBlock x:Name="ConstraintNotice" TextWrapping="Wrap" Margin="8" Text="Inspect to read constraints."/>
   <DataGrid x:Name="ConstraintsGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="ConstraintSelected" EnableRowVirtualization="True" HeadersVisibility="Column" AutomationProperties.Name="Table constraints">
    <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="190"/><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110"/><DataGridCheckBoxColumn Header="Validated" Binding="{Binding Validated}" Width="80"/><DataGridCheckBoxColumn Header="Deferrable" Binding="{Binding Deferrable}" Width="90"/><DataGridCheckBoxColumn Header="Initially deferred" Binding="{Binding InitiallyDeferred}" Width="125"/></DataGrid.Columns>
   </DataGrid>
   <TextBox x:Name="ConstraintDetail" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" FontFamily="Consolas" AutomationProperties.Name="Selected constraint definition"/>
  </Grid></TabItem><TabItem Header="Incoming FKs"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions>
   <TextBlock x:Name="IncomingNotice" TextWrapping="Wrap" Margin="8" Text="Inspect to read incoming foreign keys."/>
   <DataGrid x:Name="IncomingGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="IncomingSelected" EnableRowVirtualization="True" HeadersVisibility="Column" AutomationProperties.Name="Incoming foreign keys">
    <DataGrid.Columns><DataGridTextColumn Header="Source schema" Binding="{Binding Schema}" Width="120"/><DataGridTextColumn Header="Source table" Binding="{Binding Table}" Width="200"/><DataGridTextColumn Header="Constraint" Binding="{Binding Name}" Width="200"/><DataGridCheckBoxColumn Header="Validated" Binding="{Binding Validated}" Width="85"/></DataGrid.Columns>
   </DataGrid>
   <TextBox x:Name="IncomingDetail" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" FontFamily="Consolas" AutomationProperties.Name="Selected incoming foreign key source and definition"/>
  </Grid></TabItem><TabItem Header="Triggers"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions>
   <TextBlock x:Name="TriggerNotice" TextWrapping="Wrap" Margin="8" Text="Inspect to read triggers."/>
   <DataGrid x:Name="TriggersGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="TriggerSelected" EnableRowVirtualization="True" HeadersVisibility="Column" AutomationProperties.Name="Table triggers">
    <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="300"/><DataGridTextColumn Header="Firing mode" Binding="{Binding Enabled}" Width="150"/><DataGridCheckBoxColumn Header="Internal" Binding="{Binding Internal}" Width="80"/></DataGrid.Columns>
   </DataGrid>
   <TextBox x:Name="TriggerDetail" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" FontFamily="Consolas" AutomationProperties.Name="Selected trigger definition"/>
  </Grid></TabItem></TabControl>
  <TextBlock x:Name="Feedback" Grid.Row="3" TextWrapping="Wrap" Margin="0,8"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelInspectionButton" Content="Cancel Inspection" Click="CancelInspection" IsEnabled="False" Padding="12,5" Margin="0,0,12,0"/><Button x:Name="TableOperationsButton" Content="Table Operations…" Click="OpenTableOperations" Padding="12,5"/><Button x:Name="ColumnOperationsButton" Content="Column Operations…" Click="OpenColumnOperations" Margin="8,0" Padding="12,5"/><Button x:Name="CloseButton" Content="Close" IsCancel="True" Padding="16,5"/></StackPanel>
 </Grid>
</Window>
