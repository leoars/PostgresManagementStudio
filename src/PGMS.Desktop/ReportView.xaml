<UserControl x:Class="PGMS.Desktop.ReportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="White" Loaded="OnLoaded">
 <UserControl.Resources>
  <!-- Same inactive selection as the Activity Monitor grids (M1030). -->
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{x:Static SystemColors.HighlightColor}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{x:Static SystemColors.HighlightTextColor}"/>
 </UserControl.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#CCCEDB" BorderThickness="0,0,0,1" Padding="12,10">
   <DockPanel>
    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="_Refresh" Click="Refresh" Padding="14,4" VerticalAlignment="Top" ToolTip="Read the report again (F5)"/>
    <StackPanel>
     <TextBlock x:Name="ReportTitle" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock x:Name="ReportTarget" Margin="0,2,0,0"/>
     <TextBlock x:Name="ReportDescription" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#444444"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <TextBlock x:Name="Feedback" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="12,6" AutomationProperties.LiveSetting="Polite"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="Sections" Margin="12,8,12,12"/>
  </ScrollViewer>
 </DockPanel>
</UserControl>
