<Window x:Class="PGMS.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ad="https://github.com/Dirkster99/AvalonDock"
 xmlns:theme="clr-namespace:AvalonDock.Themes.VS;assembly=AvalonDock.Themes.VS"
 xmlns:themeKeys="clr-namespace:AvalonDock.Themes.VS.Themes;assembly=AvalonDock.Themes.VS"
 xmlns:local="clr-namespace:PGMS.Desktop"
 xmlns:vm="clr-namespace:PGMS.Desktop.ViewModels"
 Title="PGMS — Postgres Management Studio" Icon="Resources/PGMS.ico" Width="1440" Height="900" MinWidth="900" MinHeight="600"
 Background="{DynamicResource ShellBrush}" WindowStartupLocation="CenterScreen"
 Loaded="WindowLoaded" Closing="WindowClosing">
 <!-- PGMS-048 (M1111): the menu sits in the title band, as in SSMS 22.11; Windows still does dragging, snapping, double click and the system menu. -->
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="30" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Window.Resources>
  <local:CatalogIconConverter x:Key="CatalogIcon"/>
  <Style x:Key="CaptionButton" TargetType="Button">
   <Setter Property="Width" Value="44"/><Setter Property="Height" Value="30"/><Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
   <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#40FFFFFF"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#66FFFFFF"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E81123"/><Setter Property="Foreground" Value="White"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#F1707A"/><Setter Property="Foreground" Value="White"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="CaptionGlyph" TargetType="Path">
   <Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/><Setter Property="StrokeThickness" Value="1"/><Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
  </Style>
 </Window.Resources>
 <DockPanel x:Name="ShellRoot">
  <Grid x:Name="TitleBand" DockPanel.Dock="Top" Height="30">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image x:Name="TitleIcon" Source="Resources/PGMS.ico" Width="16" Height="16" Margin="8,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
    WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="TitleIconClicked" ToolTip="PGMS — Postgres Management Studio" AutomationProperties.Name="System menu"/>
   <StackPanel x:Name="CaptionButtons" Grid.Column="3" Orientation="Horizontal">
    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="MinimizeClicked" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Style="{StaticResource CaptionGlyph}" Data="M0,5.5 L10,5.5"/></Button>
    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="MaximizeClicked" ToolTip="Maximize" AutomationProperties.Name="Maximize"><Path x:Name="MaximizeGlyph" Style="{StaticResource CaptionGlyph}" Data="M0.5,0.5 L9.5,0.5 9.5,9.5 0.5,9.5 Z"/></Button>
    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="CloseClicked" ToolTip="Close" AutomationProperties.Name="Close"><Path Style="{StaticResource CaptionGlyph}" Data="M0,0 L10,10 M10,0 L0,10"/></Button>
   </StackPanel>
  <!-- B4 (M1134): as in SSMS, Tab never lands on the menu bar (Alt and F10 open it); before, Tab went from the windows to File, Edit, View... -->
  <Menu x:Name="MainMenu" Grid.Column="1" KeyboardNavigation.TabNavigation="None" VerticalAlignment="Center" Background="Transparent" Padding="0,2" WindowChrome.IsHitTestVisibleInChrome="True">
   <MenuItem x:Name="FileMenu" Header="_File" SubmenuOpened="FileMenuOpened">
    <MenuItem x:Name="NewMenu" Header="_New">
     <MenuItem x:Name="NewQueryCurrentMenu" Header="_Query with Current Connection" Command="New" InputGestureText="Ctrl+N" ToolTip="New query tab connected to the server of the active query or of Object Explorer"/>
     <MenuItem x:Name="NewDatabaseEngineQueryMenu" Header="_Database Engine Query" Click="NewDatabaseEngineQuery" ToolTip="Asks for the connection, then opens a query tab on it"/>
     <MenuItem x:Name="NewFileMenu" Header="_File…" Command="{x:Static local:MainWindow.NewFileCommand}" InputGestureText="Ctrl+Alt+N" ToolTip="New SQL or text file, not connected, or Template Explorer"/>
    </MenuItem>
    <MenuItem x:Name="OpenMenu" Header="_Open">
     <MenuItem x:Name="OpenFileMenu" Header="_File…" Command="Open" InputGestureText="Ctrl+O" ToolTip="Opens each file in a tab connected to the server of the active query or of Object Explorer; without one, the tab stays disconnected. Nothing is executed"/>
     <MenuItem x:Name="OpenFileWithNewConnectionMenu" Header="File with New _Connection…" Click="OpenFileWithNewConnection" ToolTip="Opens each file in a tab with its own new connection to the server of the active query; nothing is executed"/>
     <MenuItem x:Name="OpenFileDisconnectedMenu" Header="File _Disconnected…" Click="OpenFileDisconnected" ToolTip="Opens each file in a tab without connecting it"/>
    </MenuItem>
    <MenuItem x:Name="OpenPlanFileMenu" Header="Open Execution _Plan…" Click="OpenPlanFile"/>
    <Separator/>
    <MenuItem Header="_Save" Command="Save" InputGestureText="Ctrl+S"/>
    <MenuItem Header="Save _As…" Click="SaveAs"/>
    <MenuItem x:Name="SaveAllMenu" Header="Save A_ll" Command="{x:Static local:MainWindow.SaveAllCommand}" InputGestureText="Ctrl+Shift+S"/>
    <Separator/><MenuItem x:Name="PageSetupMenu" Header="Page Set_up..." Click="PageSetupClicked" ToolTip="Paper size, orientation and margins for printing"/><MenuItem x:Name="PrintMenu" Header="_Print..." Click="PrintClicked" ToolTip="Prints the SQL of the active query tab, or its selection"/>
    <Separator/><MenuItem x:Name="RecentFilesMenu" Header="Recent _Files"/>
    <Separator/><MenuItem Header="E_xit" Click="Exit"/>
   </MenuItem>
   <MenuItem x:Name="EditMenu" Header="_Edit" SubmenuOpened="EditMenuOpened">
    <MenuItem Header="_Undo" Command="Undo"/><MenuItem Header="_Redo" Command="Redo"/>
    <Separator/><MenuItem Header="Cu_t" Command="Cut"/><MenuItem Header="_Copy" Command="Copy"/><MenuItem Header="_Paste" Command="Paste"/><MenuItem x:Name="PasteSpecialMenu" Header="Paste _Special"><MenuItem x:Name="PasteFormattedMenu" Header="_Format SQL" Click="PasteFormattedClicked" ToolTip="Pastes the clipboard text laid out by Format SQL"/><MenuItem x:Name="PasteWithAiMenu" Header="Paste with _AI…" Click="PasteWithAiClicked" ToolTip="Opens Generate SQL with AI with the clipboard SQL and a request to adapt it to this database. Nothing is sent until Generate"/></MenuItem>
    <MenuItem x:Name="ClipboardHistoryMenu" Header="Show Clip_board History" Command="{x:Static local:SqlEditorCommands.ShowClipboardHistory}" InputGestureText="Ctrl+Shift+V" ToolTip="What was copied or cut in the SQL editors of this session; choose one to paste it"/>
    <MenuItem x:Name="DuplicateMenu" Header="_Duplicate" Command="{x:Static local:SqlEditorCommands.Duplicate}" ToolTip="Copies the selection right after it, or the current line below it. Ctrl+D stays Results to Grid, as in SSMS"/>
    <Separator/><MenuItem x:Name="FindAndReplaceMenu" Header="_Find and Replace">
     <MenuItem Header="_Quick Find" Click="Find" InputGestureText="Ctrl+F"/>
     <MenuItem x:Name="ReplaceMenu" Header="Quick _Replace" Command="Replace" InputGestureText="Ctrl+H"/>
     <MenuItem x:Name="FindInFilesMenu" Header="Find in _Files" Click="FindInFilesClicked"/>
     <MenuItem x:Name="ReplaceInFilesMenu" Header="Replace in F_iles" Command="{x:Static local:MainWindow.ReplaceInFilesCommand}" InputGestureText="Ctrl+Shift+H"/>
    </MenuItem>
    <MenuItem Header="Go To _Line…" Command="{x:Static local:QueryView.GoToLineCommand}" InputGestureText="Ctrl+G"/>
    <MenuItem x:Name="NextIssueMenu" Header="Go To Next Issue in File" Command="{x:Static local:SqlBookmarkCommands.NextIssue}" InputGestureText="Alt+PgDn" ToolTip="The position of the error the server reported in the last run"/>
    <MenuItem x:Name="PreviousIssueMenu" Header="Go To Previous Issue in File" Command="{x:Static local:SqlBookmarkCommands.PreviousIssue}" InputGestureText="Alt+PgUp"/>
    <MenuItem x:Name="LastEditLocationMenu" Header="Go To Last Edit Location" Command="{x:Static local:SqlEditorCommands.GoToLastEditLocation}" InputGestureText="Ctrl+Shift+Backspace" ToolTip="The query tab changed last, at the place of the change"/>    <Separator/><MenuItem x:Name="InsertFileAsTextMenu" Header="Insert File As Te_xt…" Click="InsertFileAsText" ToolTip="Inserts the text of a file at the caret; nothing is executed"/>
    <MenuItem x:Name="AdvancedEditMenu" Header="Ad_vanced" SubmenuOpened="AdvancedMenuOpened">
     <MenuItem x:Name="SpellCheckerMenu" Header="Toggle Spell Checker" IsCheckable="False" Click="ToggleSpellChecker" ToolTip="Underlines misspelled words in comments and strings with the spell checker of Windows; off by default"/>
     <MenuItem x:Name="FormatSqlMenu" Header="Format SQL" Command="{x:Static local:SqlEditorCommands.FormatSql}" InputGestureText="Ctrl+K, Ctrl+Q" ToolTip="Lays out the selection, or the whole document, as in SSMS; only spaces, line breaks and keyword case change, and nothing is executed"/>
     <MenuItem x:Name="TabifyMenu" Header="Tabify Selected Lines" Command="{x:Static local:SqlEditorCommands.Tabify}"/>
     <MenuItem x:Name="UntabifyMenu" Header="Untabify Selected Lines" Command="{x:Static local:SqlEditorCommands.Untabify}"/>
     <MenuItem x:Name="MakeUppercaseMenu" Header="Make Uppercase" Command="{x:Static local:SqlEditorCommands.MakeUppercase}" InputGestureText="Ctrl+Shift+U"/>
     <MenuItem x:Name="MakeLowercaseMenu" Header="Make Lowercase" Command="{x:Static local:SqlEditorCommands.MakeLowercase}" InputGestureText="Ctrl+Shift+L"/>
     <MenuItem x:Name="MoveLinesUpMenu" Header="Move Selected Lines Up" Command="{x:Static local:SqlEditorCommands.MoveLinesUp}" InputGestureText="Alt+Up Arrow"/>
     <MenuItem x:Name="MoveLinesDownMenu" Header="Move Selected Lines Down" Command="{x:Static local:SqlEditorCommands.MoveLinesDown}" InputGestureText="Alt+Down Arrow"/>
     <MenuItem x:Name="DeleteHorizontalWhiteSpaceMenu" Header="Delete Horizontal White Space" Command="{x:Static local:SqlEditorCommands.DeleteHorizontalWhiteSpace}" InputGestureText="Ctrl+K, Ctrl+\"/>
     <MenuItem x:Name="ExpandToBlockMenu" Header="Expand Selection to Containing Block" Command="{x:Static local:SqlEditorCommands.ExpandToContainingBlock}" InputGestureText="Shift+Alt+]" ToolTip="The parentheses around the selection, or its statement"/>
     <MenuItem x:Name="ExpandSelectionMenu" Header="Expand Selection" Command="{x:Static local:SqlEditorCommands.ExpandSelection}" InputGestureText="Shift+Alt+=" ToolTip="Word, quoted text, parentheses, statement, document: the next larger one each time"/>
     <MenuItem x:Name="AdvancedWhiteSpaceMenu" Header="View White Space" IsCheckable="True" Click="ToggleWhiteSpace" ToolTip="Show spaces and tabs in the active SQL document"/>
     <MenuItem x:Name="AdvancedWordWrapMenu" Header="Word Wrap" IsCheckable="True" Click="ToggleWordWrap" ToolTip="Wrap SQL visually without inserting line breaks"/>
     <MenuItem x:Name="IncrementalSearchMenu" Header="Incremental Search" Command="{x:Static local:SqlEditorCommands.IncrementalSearch}" ToolTip="Type to search forward; Ctrl+I or F3 for the next match, Enter or Esc to stop. Ctrl+I alone stays Generate SQL with AI"/>
     <MenuItem x:Name="ToggleLineCommentMenu" Header="Toggle Line Comment" Command="{x:Static local:SqlEditorCommands.ToggleLineComment}" InputGestureText="Ctrl+/"/>
     <MenuItem x:Name="ToggleBlockCommentMenu" Header="Toggle Block Comment" Command="{x:Static local:SqlEditorCommands.ToggleBlockComment}" InputGestureText="Ctrl+Shift+/"/>
     <MenuItem x:Name="SortLinesMenu" Header="Sort Lines" Command="{x:Static local:SqlEditorCommands.SortLines}" InputGestureText="Shift+Alt+L, Shift+Alt+S"/>
     <MenuItem x:Name="JoinLinesMenu" Header="Join Lines" Command="{x:Static local:SqlEditorCommands.JoinLines}" InputGestureText="Shift+Alt+L, Shift+Alt+J"/>
     <MenuItem x:Name="NextSubwordMenu" Header="Next subword" Command="{x:Static local:SqlEditorCommands.NextSubword}" InputGestureText="Ctrl+Alt+Right Arrow"/>
     <MenuItem x:Name="PreviousSubwordMenu" Header="Previous subword" Command="{x:Static local:SqlEditorCommands.PreviousSubword}" InputGestureText="Ctrl+Alt+Left Arrow"/>
     <MenuItem x:Name="ExpandToLineMenu" Header="Expand Selection to Line" Command="{x:Static local:SqlEditorCommands.ExpandToLine}" InputGestureText="Shift+Alt+E"/>
     <MenuItem x:Name="CommentSelectionMenu" Header="Comment Selection" Command="{x:Static local:SqlEditorCommands.Comment}" InputGestureText="Ctrl+K, Ctrl+C"/>
     <MenuItem x:Name="UncommentSelectionMenu" Header="Uncomment Selection" Command="{x:Static local:SqlEditorCommands.Uncomment}" InputGestureText="Ctrl+K, Ctrl+U"/>
     <MenuItem x:Name="IncreaseIndentMenu" Header="Increase Line Indent" Command="{x:Static local:SqlEditorCommands.IncreaseIndent}"/>
     <MenuItem x:Name="DecreaseIndentMenu" Header="Decrease Line Indent" Command="{x:Static local:SqlEditorCommands.DecreaseIndent}"/>
     <MenuItem x:Name="SetLineEndingsMenu" Header="Set End of Line Sequence"><MenuItem Header="CRLF" Command="{x:Static local:SqlEditorCommands.LineEndingsCrLf}"/><MenuItem Header="LF" Command="{x:Static local:SqlEditorCommands.LineEndingsLf}"/><MenuItem Header="CR" Command="{x:Static local:SqlEditorCommands.LineEndingsCr}"/></MenuItem>
     <MenuItem x:Name="SetIndentationMenu" Header="Set Indentation"><MenuItem Header="Spaces" Command="{x:Static local:SqlEditorCommands.IndentWithSpaces}"/><MenuItem Header="Tabs" Command="{x:Static local:SqlEditorCommands.IndentWithTabs}"/></MenuItem>
     <MenuItem x:Name="SetEncodingMenu" Header="Set Encoding"><MenuItem Header="Reopen with Encoding" Command="{x:Static local:SqlEditorCommands.ReopenWithEncoding}"/><MenuItem Header="Save with Encoding" Command="{x:Static local:SqlEditorCommands.SaveWithEncoding}"/></MenuItem>
    </MenuItem>
    <MenuItem x:Name="BookmarksMenu" Header="_Bookmarks">
     <MenuItem Header="Toggle Bookmark" Command="{x:Static local:SqlBookmarkCommands.ToggleBookmark}" InputGestureText="Ctrl+K, Ctrl+K"/>
     <MenuItem Header="Previous Bookmark" Command="{x:Static local:SqlBookmarkCommands.PreviousBookmark}" InputGestureText="Ctrl+K, Ctrl+P"/>
     <MenuItem Header="Next Bookmark" Command="{x:Static local:SqlBookmarkCommands.NextBookmark}" InputGestureText="Ctrl+K, Ctrl+N"/>
     <MenuItem Header="Clear Bookmarks" Command="{x:Static local:SqlBookmarkCommands.ClearBookmarks}" InputGestureText="Ctrl+K, Ctrl+L" ToolTip="Deletes the bookmarks of every query tab, after confirming"/>
     <MenuItem Header="Previous Bookmark In Document" Command="{x:Static local:SqlBookmarkCommands.PreviousBookmarkInDocument}"/>
     <MenuItem Header="Next Bookmark In Document" Command="{x:Static local:SqlBookmarkCommands.NextBookmarkInDocument}"/>
     <MenuItem Header="Clear All Bookmarks In Document" Command="{x:Static local:SqlBookmarkCommands.ClearBookmarksInDocument}"/>
    </MenuItem>
    <MenuItem x:Name="OutliningMenu" Header="_Outlining" ToolTip="Ctrl+M stays Include Actual Execution Plan; the outlining commands have no shortcut">
     <MenuItem Header="Toggle Outlining Expansion" Command="{x:Static local:SqlBookmarkCommands.ToggleOutliningExpansion}"/>
     <MenuItem Header="Toggle All Outlining" Command="{x:Static local:SqlBookmarkCommands.ToggleAllOutlining}"/>
     <MenuItem Header="Stop Outlining" Command="{x:Static local:SqlBookmarkCommands.StopOutlining}"/>
     <MenuItem Header="Start Automatic Outlining" Command="{x:Static local:SqlBookmarkCommands.StartOutlining}"/>
    </MenuItem>
    <MenuItem x:Name="IntelliSenseEditMenu" Header="_IntelliSense">
     <MenuItem x:Name="ListMembersMenu" Header="List _Members" InputGestureText="Ctrl+J" Click="ListMembers"/>
     <MenuItem x:Name="ParameterInfoMenu" Header="_Parameter Info" InputGestureText="Ctrl+Shift+Space" Click="ParameterInfo" ToolTip="Signature of the function whose parentheses hold the caret, from the IntelliSense cache"/>
     <MenuItem x:Name="QuickInfoMenu" Header="_Quick Info" InputGestureText="Ctrl+K, Ctrl+I" Click="QuickInfo" ToolTip="What the name at the caret is (table, view, column, function or schema), from the IntelliSense cache"/>
     <MenuItem x:Name="CompleteWordMenu" Header="Complete _Word" InputGestureText="Ctrl+Space" Click="ListMembers"/>
     <MenuItem x:Name="SwitchCompletionModeMenu" Header="Switch _Completion Mode" InputGestureText="Ctrl+Alt+Space" IsCheckable="False" Click="SwitchCompletionModeClicked" ToolTip="Suggestion mode (checked): Tab inserts the highlighted name and Enter keeps what you typed. Completion mode: Enter or Tab inserts"/>
     <MenuItem x:Name="RefreshCacheMenu" Header="_Refresh Local Cache" InputGestureText="Ctrl+Shift+R" Click="RefreshLocalCache"/>
     <MenuItem x:Name="SurroundWithMenu" Header="_Surround With…" InputGestureText="Ctrl+K, Ctrl+S" Click="SurroundWithClicked" ToolTip="Wraps the selection in a snippet (transaction, DO block, IF, WHILE…)"/>
     <MenuItem x:Name="InsertSnippetMenu" Header="Insert S_nippet…" InputGestureText="Ctrl+K, Ctrl+X" Click="InsertSnippetClicked" ToolTip="Inserts a code snippet; Tab moves between its fields"/>
    </MenuItem>
   </MenuItem>
   <MenuItem Header="_View" SubmenuOpened="ViewMenuOpened"><MenuItem Header="Object _Explorer" Click="ShowExplorer" InputGestureText="F8"/><MenuItem x:Name="ObjectExplorerDetailsMenu" Header="Object Explorer _Details" Click="ShowObjectExplorerDetails" InputGestureText="F7" ToolTip="A document listing what the node selected in Object Explorer contains; it follows the selection"/><MenuItem Header="Re_gistered Servers" Click="ShowRegisteredServers" InputGestureText="Ctrl+Alt+G" ToolTip="Saved connection profiles organized in server groups"/><MenuItem x:Name="TemplateExplorerMenu" Header="_Template Explorer" Click="ShowTemplateExplorer" InputGestureText="Ctrl+Alt+T" ToolTip="PostgreSQL templates grouped in folders, plus your own .sql files; opening one starts a query tab"/><MenuItem x:Name="ErrorListMenu" Header="Error L_ist" Click="ShowErrorList" InputGestureText="Ctrl+\, E" ToolTip="The error of the last run of each open query tab; double-click goes to it"/><MenuItem x:Name="OutputMenu" Header="_Output" Click="ShowOutput" InputGestureText="Ctrl+Alt+O" ToolTip="Messages and executions of this session, with the time"/><MenuItem x:Name="ActivityMonitorMenu" Header="Activity _Monitor" Click="ShowActivity" InputGestureText="Ctrl+Alt+A" ToolTip="Opens a document tab; a tab already monitoring the same server and user is activated"/><MenuItem Header="Query Statistics…" Click="ShowQueryStatistics" ToolTip="Read-only pg_stat_statements view; the extension must already be loaded and created"/><MenuItem x:Name="QueryHistoryMenu" Header="Query _History…" Click="ShowQueryHistory" InputGestureText="Ctrl+Alt+H" ToolTip="Queries executed in PGMS query tabs, recorded on this computer and encrypted for this Windows user; never sent to a server"/><Separator/><MenuItem x:Name="WordWrapMenu" Header="Word Wrap" IsCheckable="True" Click="ToggleWordWrap" ToolTip="Wrap SQL visually without inserting line breaks"/><MenuItem x:Name="WhiteSpaceMenu" Header="Show White Space" IsCheckable="True" Click="ToggleWhiteSpace" ToolTip="Show spaces and tabs in the active SQL document"/><Separator/><MenuItem x:Name="PresenterModeMenu" Header="_Presenter Mode" SubmenuOpened="PresenterModeMenuOpened"><MenuItem x:Name="TogglePresenterModeMenu" Header="Toggle _Presenter Mode" Command="{x:Static local:MainWindow.PresenterModeCommand}" InputGestureText="Ctrl+Shift+F5" ToolTip="Larger fonts in the editor, the results and the main window, for this session"/><MenuItem Header="_Edit Presenter Mode Settings" Click="EditPresenterModeSettings"/><MenuItem Header="_Restore Default Font Settings" Click="RestoreDefaultFontSettingsClicked" ToolTip="Fonts and sizes of Fonts and Colors back to the PGMS defaults; colors are kept"/></MenuItem><MenuItem x:Name="ToolbarsMenu" Header="_Toolbars" SubmenuOpened="ToolbarsMenuOpened"><MenuItem x:Name="StandardToolbarMenu" Header="Standard" IsCheckable="True" Click="ToggleToolbar" Tag="Standard"/><MenuItem x:Name="SqlEditorToolbarMenu" Header="SQL Editor" IsCheckable="True" Click="ToggleToolbar" Tag="SQL Editor"/><Separator/><MenuItem Header="_Customize…" Click="ShowCustomize"/></MenuItem><MenuItem x:Name="FullScreenMenu" Header="F_ull Screen" IsCheckable="False" Command="{x:Static local:MainWindow.FullScreenCommand}" InputGestureText="Shift+Alt+Enter" ToolTip="No title bar or toolbars; the same command returns"/><MenuItem x:Name="AllWindowsMenu" Header="_All Windows" Command="{x:Static local:MainWindow.AllWindowsCommand}" InputGestureText="Shift+Alt+M" ToolTip="In Full Screen, hides the tool windows to leave only the documents; the same command shows them again"/><MenuItem x:Name="NavigateBackwardMenu" Header="Navigate _Backward" Command="{x:Static local:MainWindow.NavigateBackwardCommand}" InputGestureText="Ctrl+-" ToolTip="Back to the previous tab or place in the editor (tab switches and jumps of 10 lines or more)"/><MenuItem x:Name="NavigateForwardMenu" Header="Navigate _Forward" Command="{x:Static local:MainWindow.NavigateForwardCommand}" InputGestureText="Ctrl+Shift+-"/><MenuItem x:Name="PropertiesWindowMenu" Header="Propert_ies Window" Click="ShowPropertiesWindow" InputGestureText="F4" ToolTip="Docked window with the properties of the active document; for a query tab, its connection and last execution"/></MenuItem>
   <MenuItem Header="_Query">
    <MenuItem x:Name="ConnectionMenu" Header="Co_nnection" SubmenuOpened="ConnectionMenuOpened">
     <MenuItem x:Name="QueryConnectMenu" Header="_Connect…" Click="QueryConnect"/>
     <MenuItem x:Name="QueryDisconnectMenu" Header="_Disconnect" Click="QueryDisconnect"/>
     <MenuItem x:Name="DisconnectAllQueriesMenu" Header="Disconnect _All Queries" Click="DisconnectAllQueries" ToolTip="Disconnects every query tab; Object Explorer stays connected"/>
     <MenuItem x:Name="QueryChangeConnectionMenu" Header="Change C_onnection…" Click="QueryChangeConnection"/>
    </MenuItem>
    <MenuItem x:Name="OpenServerMenu" Header="Open Ser_ver in Object Explorer" InputGestureText="Alt+F8" Click="OpenServerInExplorer" IsEnabled="False"/>
    <MenuItem x:Name="SpecifyTemplateParametersMenu" Header="Specify Values for Te_mplate Parameters…" Command="{x:Static local:MainWindow.SpecifyTemplateParametersCommand}" InputGestureText="Ctrl+Shift+M" ToolTip="Fills every &lt;name, type, value&gt; parameter of the query"/>
    <Separator/>
    <MenuItem Header="_Execute" Click="Execute" InputGestureText="Alt+X" x:Name="ExecuteMenu" IsEnabled="False"/>
    <MenuItem Header="_Cancel Executing Query" Click="CancelQuery" InputGestureText="Alt+Break" x:Name="CancelMenu" IsEnabled="False"/>
    <Separator/>
    <MenuItem x:Name="ParseMenu" Header="Pa_rse" InputGestureText="Ctrl+F5" Click="ParseQuery" IsEnabled="False"/>
    <MenuItem x:Name="EstimatedPlanMenu" Header="Display E_stimated Execution Plan" InputGestureText="Ctrl+L" Click="DisplayEstimatedPlan" IsEnabled="False"/>
    <MenuItem x:Name="IntelliSenseMenu" Header="_IntelliSense Enabled" InputGestureText="Ctrl+B, Ctrl+I" Click="ToggleIntelliSense" IsEnabled="False"/>
    <Separator/>
    <MenuItem x:Name="DesignQueryMenu" Header="_Design Query in Editor…" Command="{x:Static local:MainWindow.DesignQueryInEditor}" InputGestureText="Ctrl+Shift+Q"/>
    <Separator/>
    <MenuItem x:Name="ActualPlanMenu" Header="Include Actual Execution _Plan" InputGestureText="Ctrl+M" Click="ToggleActualPlan" IsEnabled="False"/>
    <MenuItem x:Name="LiveStatisticsMenu" Header="Include Li_ve Query Statistics" Click="ToggleLiveStatistics" IsEnabled="False" ToolTip="While the query runs: state, waits, blocking and the progress PostgreSQL reports (no live plan)"/>
                <MenuItem x:Name="ClientStatisticsMenu" Header="Include C_lient Statistics" InputGestureText="Shift+Alt+S" Click="ToggleClientStatistics" IsEnabled="False"/>
    <MenuItem x:Name="ResetClientStatisticsMenu" Header="Reset Client Statistics" Click="ResetClientStatistics" IsEnabled="False"/>
    <Separator/>
    <MenuItem x:Name="ResultsToMenu" Header="Results _To" SubmenuOpened="ResultsToMenuOpened">
     <MenuItem x:Name="ResultsToTextMenu" Header="Results to _Text" InputGestureText="Ctrl+T" Icon="{StaticResource ResultsTextIcon}" Click="ResultsToText"/>
     <MenuItem x:Name="ResultsToGridMenu" Header="Results to _Grid" InputGestureText="Ctrl+D" Icon="{StaticResource ResultsGridIcon}" Click="ResultsToGrid"/>
     <MenuItem x:Name="ResultsToFileMenu" Header="Results to _File" InputGestureText="Ctrl+Shift+F" Icon="{StaticResource ResultsFileIcon}" Click="ResultsToFile"/>
    </MenuItem>
    <MenuItem x:Name="QueryOptionsMenu" Header="Query _Options…" Command="{x:Static local:MainWindow.ShowQueryOptions}" Icon="{StaticResource QueryOptionsIcon}"/>
    <Separator/>
    <MenuItem x:Name="GenerateSqlMenu" Header="Generate SQL with _AI…" Command="{x:Static local:MainWindow.GenerateSqlWithAi}" InputGestureText="Ctrl+I"/><MenuItem x:Name="ExplainSqlAiMenu" Header="Explain SQL with AI…" Click="ExplainSqlWithAi" ToolTip="Opens the AI assistant with the selected SQL (or the whole query) and a request to explain it; nothing is sent until Generate"/><MenuItem x:Name="FixSqlAiMenu" Header="Fix SQL with AI…" Click="FixSqlWithAi" ToolTip="Opens the AI assistant with the SQL and the SQLSTATE and message of the last error; nothing is sent until Generate"/><MenuItem x:Name="OptimizeSqlAiMenu" Header="Optimize SQL with AI…" Click="OptimizeSqlWithAi" ToolTip="Opens the AI assistant with the SQL and a request to make it faster without changing its results; nothing is sent until Generate"/>
   </MenuItem>
   <MenuItem x:Name="TableDesignerMenu" Header="Table _Designer" Visibility="Collapsed" SubmenuOpened="TableDesignerMenuOpened">
    <MenuItem x:Name="DesignerPrimaryKeyMenu" Header="Set Primary Key" Icon="{StaticResource DesignerIconKey}" Click="DesignerPrimaryKey"/>
    <MenuItem x:Name="DesignerInsertMenu" Header="Insert Column" Icon="{StaticResource DesignerIconInsert}" Click="DesignerInsertColumn"/>
    <MenuItem x:Name="DesignerDeleteMenu" Header="Delete Column" Icon="{StaticResource DesignerIconDelete}" Click="DesignerDeleteColumn"/>
    <Separator/>
    <MenuItem Header="Relationships…" Icon="{StaticResource DesignerIconRelationships}" Click="DesignerRelationships"/>
    <MenuItem Header="Indexes/Keys…" Icon="{StaticResource DesignerIconIndexes}" Click="DesignerIndexes"/>
    <MenuItem Header="Check Constraints…" Icon="{StaticResource DesignerIconChecks}" Click="DesignerChecks"/>
    <Separator/>
    <MenuItem x:Name="DesignerScriptMenu" Header="Generate Change Script…" Icon="{StaticResource DesignerIconScript}" Click="DesignerScript"/>
   </MenuItem>
   <MenuItem Header="_Tools">
    <MenuItem x:Name="NewDatabaseMenu" Header="New _Database…" Click="NewDatabase" IsEnabled="False"/>
    <MenuItem x:Name="NewSchemaMenu" Header="New _Schema…" Click="NewSchema" IsEnabled="False"/>
    <MenuItem Header="Schema Operations…" Click="SchemaOperations"/>
    <MenuItem Header="New Table…" Click="NewTable"/>
                <MenuItem Header="Sequence Operations..." Click="SequenceOperations"/>
                <MenuItem Header="Table Properties..." Click="TableProperties"/>
    <MenuItem Header="Table Operations…" Click="TableOperations"/>
    <MenuItem Header="Index Operations…" Click="IndexOperations"/>
    <MenuItem Header="Constraint Operations…" Click="TableConstraintOperations"/>
