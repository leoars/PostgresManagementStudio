<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PGMS.Desktop">
 <SolidColorBrush x:Key="ShellBrush" Color="#A8C7D9" />
 <SolidColorBrush x:Key="PanelBrush" Color="#F5FAFE" />
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/></Style>
 <Style TargetType="ToolBar"><Setter Property="Background" Value="#D5E5EF"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style TargetType="ToolTip"><Setter Property="FontSize" Value="12"/></Style>
 <!-- SSMS 22.11 tree expander, sampled from its Object Explorer at 100%: 9x9 box with #919191 border, softened corners and a light-to-grey fill;
      the horizontal bar is #4B63A7 and the vertical bar of "+" is #294272. -->
 <Style x:Key="SsmsExpanderToggle" TargetType="ToggleButton">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="Width" Value="16"/>
  <Setter Property="Height" Value="16"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border Background="Transparent" Width="16" Height="16">
      <Grid Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True">
       <Border BorderBrush="#919191" BorderThickness="1" CornerRadius="1">
        <Border.Background>
         <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#FCFCFC" Offset="0"/><GradientStop Color="#FCFCFC" Offset="0.28"/><GradientStop Color="#FAFBFB" Offset="0.3"/>
          <GradientStop Color="#FAFBFB" Offset="0.57"/><GradientStop Color="#EDEDEC" Offset="0.6"/><GradientStop Color="#E3E3E3" Offset="0.72"/><GradientStop Color="#E3E3E3" Offset="1"/>
         </LinearGradientBrush>
        </Border.Background>
       </Border>
       <Canvas Width="9" Height="9">
        <Rectangle x:Name="Vertical" Canvas.Left="4" Canvas.Top="2" Width="1" Height="5" Fill="#294272"/>
        <Rectangle Canvas.Left="2" Canvas.Top="4" Width="5" Height="1" Fill="#4B63A7"/>
       </Canvas>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Vertical" Property="Visibility" Value="Collapsed"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Dotted focus rectangle sampled from SSMS 22.11 at 100%: pixels alternate between black and #FF8728, the inverse of the #0078D7 selection. -->
 <DrawingBrush x:Key="SsmsTreeFocusBrush" Viewport="0,0,2,2" ViewportUnits="Absolute" TileMode="Tile" Stretch="None">
  <DrawingBrush.Drawing>
   <DrawingGroup>
    <GeometryDrawing Brush="Black" Geometry="M0,0H2V2H0Z"/>
    <GeometryDrawing Brush="#FF8728" Geometry="M0,0H1V1H0Z M1,1H2V2H1Z"/>
   </DrawingGroup>
  </DrawingBrush.Drawing>
 </DrawingBrush>
 <!-- Selection box of a tree node. As in SSMS it wraps the label only, so the icon stays on the panel background. -->
 <Style x:Key="SsmsTreeLabel" TargetType="Border">
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="Padding" Value="1,0"/>
  <Setter Property="Height" Value="18"/>
  <Setter Property="UseLayoutRounding" Value="True"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
  <Style.Triggers>
   <MultiDataTrigger>
    <MultiDataTrigger.Conditions>
     <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"/>
     <Condition Binding="{Binding (Selector.IsSelectionActive), RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"/>
    </MultiDataTrigger.Conditions>
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SsmsTreeFocusBrush}"/>
   </MultiDataTrigger>
   <MultiDataTrigger>
    <MultiDataTrigger.Conditions>
     <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"/>
     <Condition Binding="{Binding (Selector.IsSelectionActive), RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="False"/>
    </MultiDataTrigger.Conditions>
    <!-- Without focus SSMS 22.11 paints #F0F0F0, almost invisible on the panel; the user chose a visible light blue (08/11/2026, conscious deviation). -->
    <Setter Property="Background" Value="#CCE4F7"/>
   </MultiDataTrigger>
  </Style.Triggers>
 </Style>
 <!-- Tree item like the WPF default, with the SSMS "+"/"-" box instead of the triangle. Used by Object Explorer and Registered Servers.
      The header paints no selection (see SsmsTreeLabel); its transparent background keeps the icon clickable. -->
 <Style x:Key="SsmsTreeViewItem" TargetType="TreeViewItem">
  <Setter Property="Padding" Value="1,0,0,0"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="TreeViewItem">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition MinWidth="19" Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <ToggleButton x:Name="Expander" Style="{StaticResource SsmsExpanderToggle}" ClickMode="Press" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
      <Border x:Name="Bd" Grid.Column="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
       <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
      </Border>
      <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
      <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
      <Trigger Property="IsSelected" Value="True">
       <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
      </Trigger>
      <MultiTrigger>
       <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="IsSelectionActive" Value="False"/></MultiTrigger.Conditions>
       <Setter Property="Foreground" Value="#1E1E1E"/>
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
   </Trigger>
  </Style.Triggers>
 </Style>
 <!-- A choice in the designer property grid reads as plain text; the arrow shows only on the row in use, like the SSMS 22.11 Column Properties. -->
 <Style x:Key="DesignerPropertyCombo" TargetType="ComboBox">
  <Setter Property="Focusable" Value="True"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid Background="Transparent">
      <ContentPresenter Margin="3,0,18,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
      <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
       <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">
         <Grid Background="Transparent"><Path x:Name="Arrow" Visibility="Hidden" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Fill="#444444" Data="M0,0 L7,0 L3.5,4 Z"/></Grid>
         <ControlTemplate.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></DataTrigger></ControlTemplate.Triggers>
        </ControlTemplate>
       </ToggleButton.Template>
      </ToggleButton>
      <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}">
       <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="White" BorderBrush="#A0A0A0" BorderThickness="1"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#8A8A8A"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Table Designer menu icons, drawn after the SSMS 22.11 ones on a 16 px grid. Not shared: an element has only one parent. -->
 <Style x:Key="DesignerMenuIcon" TargetType="Viewbox">
  <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
  <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></Style.Triggers>
 </Style>
 <!-- Results grid as in SSMS 22.11, measured on the user's captures (08/11/2026): rows and headers 19 px, cells/headers/empty area #F5F5F5,
      grid lines #CCCEDB drawn by each cell (so they end at the last column), outer border #ABADB3, numbered row headers, NULL cells #FDFBAC,
      dotted rectangle on the current cell, selected cells #A5CFF1 (measured with the grid not focused; the focused colour is assumed the same), text 8 px after the line. -->
 <Style x:Key="SsmsGridGripper" TargetType="Thumb">
  <Setter Property="Width" Value="5"/><Setter Property="Cursor" Value="SizeWE"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SsmsResultColumnHeader" TargetType="DataGridColumnHeader">
  <Setter Property="Foreground" Value="#1E1E1E"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="DataGridColumnHeader">
     <Grid Background="#F5F5F5" SnapsToDevicePixels="True">
      <Border BorderBrush="#CCCEDB" BorderThickness="0,0,1,1"/>
      <DockPanel Margin="7,0,8,1">
       <Path x:Name="SortArrow" DockPanel.Dock="Right" Width="7" Height="4" Margin="4,0,0,0" Fill="#717171" Stretch="Fill" VerticalAlignment="Center" Visibility="Collapsed" Data="M0,4 L3.5,0 7,4 Z"/>
       <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="False"/>
      </DockPanel>
      <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource SsmsGridGripper}"/>
      <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource SsmsGridGripper}"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/><Setter TargetName="SortArrow" Property="Data" Value="M0,0 L7,0 3.5,4 Z"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="SsmsResultRowHeader" TargetType="DataGridRowHeader">
  <Setter Property="Foreground" Value="#1E1E1E"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="DataGridRowHeader">
     <Grid Background="#F5F5F5" SnapsToDevicePixels="True">
      <Border BorderBrush="#CCCEDB" BorderThickness="0,0,1,1"/>
      <ContentPresenter Margin="4,0,4,1" VerticalAlignment="Center" HorizontalAlignment="Left"/>
     </Grid>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="SsmsResultCell" TargetType="DataGridCell">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Foreground" Value="#1E1E1E"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="DataGridCell">
     <Grid x:Name="Root" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
      <Border BorderBrush="#CCCEDB" BorderThickness="0,0,1,1"/>
      <ContentPresenter Margin="7,0,8,1" VerticalAlignment="Center"/>
      <Rectangle x:Name="Current" Margin="0,0,1,1" Stroke="#000000" StrokeThickness="1" StrokeDashArray="1 1" Visibility="Collapsed" SnapsToDevicePixels="True"/>
     </Grid>
     <ControlTemplate.Triggers>
      <DataTrigger Value="True">
       <DataTrigger.Binding>
        <MultiBinding Converter="{x:Static local:IsCurrentCellConverter.Instance}">
         <Binding Path="Column" RelativeSource="{RelativeSource Self}"/>
         <Binding Path="DataContext" RelativeSource="{RelativeSource Self}"/>
         <Binding Path="CurrentColumn" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
         <Binding Path="CurrentItem" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
        </MultiBinding>
       </DataTrigger.Binding>
       <Setter TargetName="Current" Property="Visibility" Value="Visible"/>
      </DataTrigger>
      <MultiDataTrigger>
       <MultiDataTrigger.Conditions>
        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"/>
       </MultiDataTrigger.Conditions>
       <Setter TargetName="Root" Property="Background" Value="#A5CFF1"/>
      </MultiDataTrigger>
      <MultiDataTrigger>
       <MultiDataTrigger.Conditions>
        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False"/>
       </MultiDataTrigger.Conditions>
       <Setter TargetName="Root" Property="Background" Value="#A5CFF1"/>
      </MultiDataTrigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="SsmsResultGrid" TargetType="DataGrid">
  <Setter Property="Background" Value="#F5F5F5"/>
  <Setter Property="RowBackground" Value="#F5F5F5"/>
  <Setter Property="AlternatingRowBackground" Value="#F5F5F5"/>
  <Setter Property="BorderBrush" Value="#ABADB3"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="GridLinesVisibility" Value="None"/>
  <Setter Property="HeadersVisibility" Value="All"/>
  <Setter Property="RowHeight" Value="19"/>
  <Setter Property="ColumnHeaderHeight" Value="19"/>
  <Setter Property="RowHeaderWidth" Value="32"/>
  <Setter Property="CanUserResizeRows" Value="False"/>
  <Setter Property="FontFamily" Value="Segoe UI"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="Foreground" Value="#1E1E1E"/>
  <Setter Property="ColumnHeaderStyle" Value="{StaticResource SsmsResultColumnHeader}"/>
  <Setter Property="RowHeaderStyle" Value="{StaticResource SsmsResultRowHeader}"/>
  <Setter Property="CellStyle" Value="{StaticResource SsmsResultCell}"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
  <Setter Property="UseLayoutRounding" Value="True"/>
  <Style.Resources>
   <!-- Top-left corner (select all): flat, like the headers. -->
   <Style x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}" TargetType="Button">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="#F5F5F5" BorderBrush="#CCCEDB" BorderThickness="0,0,1,1"/></ControlTemplate></Setter.Value></Setter>
   </Style>
  </Style.Resources>
 </Style>
