 <!-- Category header of the designer property grid: checked means expanded. -->
 <Style x:Key="DesignerCategoryToggle" TargetType="ToggleButton">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border Background="#EEF3FA" Padding="5,1,0,1">
      <StackPanel Orientation="Horizontal">
       <Grid Width="12" VerticalAlignment="Center"><Path x:Name="Chevron" Fill="#444444" HorizontalAlignment="Left" VerticalAlignment="Center" Data="M0,0 L8,0 L4,5 Z"/></Grid>
       <ContentPresenter TextElement.FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
     <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="False"><Setter TargetName="Chevron" Property="Data" Value="M0,0 L5,4 L0,8 Z"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
</ResourceDictionary>
