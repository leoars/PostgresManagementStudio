<Window x:Class="PGMS.Desktop.QueryHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PGMS.Desktop" Title="Query History" Width="1100" Height="680" MinWidth="760" MinHeight="480" Background="#F5F5F5" WindowStartupLocation="CenterOwner" Loaded="OnLoaded">
 <DockPanel Margin="12">
  <Border DockPanel.Dock="Top" Background="#E4EFF6" Padding="10" Margin="0,0,0,10"><TextBlock x:Name="Target" TextWrapping="Wrap" AutomationProperties.Name="Query History storage"/></Border>
  <Border x:Name="DisabledBanner" DockPanel.Dock="Top" Background="#FFF4CE" BorderBrush="#E0C068" BorderThickness="1" Padding="10" Margin="0,0,0,10" Visibility="Collapsed"><TextBlock TextWrapping="Wrap" Text="Recording is turned off in Tools ▸ Options ▸ Query Execution ▸ Query History. The executions below were recorded earlier." AutomationProperties.Name="Query History recording is off"/></Border>
  <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
   <Button x:Name="RefreshButton" Content="_Refresh" Click="Refresh" Padding="12,5"/>
   <Button x:Name="OpenButton" Content="_Open in New Query" Click="Open" Padding="12,5" Margin="8,0,0,0" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Opens the SQL in a new query tab, connected to the same server, database and user when such a connection is already open in PGMS. Nothing is executed." AutomationProperties.Name="Open in new query tab"/>
   <Button x:Name="CopyButton" Content="_Copy SQL" Click="Copy" Padding="12,5" Margin="8,0,0,0" IsEnabled="False"/>
   <Button x:Name="PinButton" Content="_Pin" Click="TogglePin" Padding="12,5" Margin="8,0,0,0" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="A pinned query is listed first, and its newest execution is kept when old executions are removed." AutomationProperties.Name="Pin or unpin the selected query"/>
   <Button x:Name="DeleteButton" Content="_Delete…" Click="Delete" Padding="12,5" Margin="8,0,0,0" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="On a query row, deletes all of its executions; on an execution row, only that one." AutomationProperties.Name="Delete the selected entry"/>
   <Button x:Name="ClearButton" Content="Clear _History…" Click="Clear" Padding="12,5" Margin="8,0,0,0" AutomationProperties.Name="Clear query history"/>
  </WrapPanel>
  <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><Label Content="_Text contains:" Target="{Binding ElementName=TextFilter}" Padding="0,0,0,2"/><TextBox x:Name="TextFilter" TextChanged="FilterChanged" AutomationProperties.Name="Query text contains" Padding="3" ToolTip="Matches the SQL, database and user, ignoring case and runs of spaces."/></StackPanel>
   <StackPanel Grid.Column="2"><Label Content="Co_nnection:" Target="{Binding ElementName=ConnectionFilter}" Padding="0,0,0,2"/><ComboBox x:Name="ConnectionFilter" SelectionChanged="FilterChanged" AutomationProperties.Name="Connection filter"/></StackPanel>
   <StackPanel Grid.Column="4"><Label Content="P_eriod:" Target="{Binding ElementName=PeriodFilter}" Padding="0,0,0,2"/><ComboBox x:Name="PeriodFilter" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Period filter"><ComboBoxItem Content="All time" Tag="0"/><ComboBoxItem Content="Today" Tag="1"/><ComboBoxItem Content="Last 7 days" Tag="7"/><ComboBoxItem Content="Last 30 days" Tag="30"/></ComboBox></StackPanel>
   <CheckBox x:Name="PinnedOnly" Grid.Column="6" Content="Pinned _only" VerticalAlignment="Bottom" Margin="0,0,0,4" Checked="FilterChanged" Unchecked="FilterChanged"/>
  </Grid>
  <TextBox x:Name="Status" DockPanel.Dock="Bottom" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,8,0,0" Height="40" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Query History status"/>
  <TextBlock x:Name="Details" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.Name="Selected execution details"/>
  <TextBox x:Name="SqlText" DockPanel.Dock="Bottom" IsReadOnly="True" FontFamily="Consolas" Height="140" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,10,0,0" AutomationProperties.Name="Selected SQL"/>
  <DataGrid x:Name="Entries" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column" EnableRowVirtualization="True" SelectionChanged="SelectionChanged" PreviewKeyDown="EntriesKeyDown" MouseDoubleClick="EntriesDoubleClick" AutomationProperties.Name="Query History" AutomationProperties.HelpText="One row per distinct query, newest first, pinned queries on top. Right arrow or the plus button lists its executions; Enter opens the SQL in a new query tab.">
   <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/><Style.Triggers><DataTrigger Binding="{Binding IsGroup}" Value="False"><Setter Property="Foreground" Value="#3C4A55"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="" Width="28"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Toggle}" Click="ToggleRow" Visibility="{Binding ToggleVisibility}" Padding="0" Width="18" Height="16" FontSize="11" Focusable="False" AutomationProperties.Name="{Binding ToggleName}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="★" Binding="{Binding PinMark}" Width="24"/>
    <DataGridTextColumn Header="Last run" Binding="{Binding When}" Width="140"/>
    <DataGridTextColumn Header="Server" Binding="{Binding Server}" Width="130"/>
    <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="100"/>
    <DataGridTextColumn Header="User" Binding="{Binding User}" Width="90"/>
    <DataGridTextColumn Header="Runs" Binding="{Binding Executions}" Width="50"/>
    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="75"/>
    <DataGridTextColumn Header="Rows" Binding="{Binding Rows}" Width="90"/>
    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90"/>
    <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="100"/>
    <DataGridTextColumn Header="SQL" Binding="{Binding Sql}" Width="*"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
