<Window x:Class="PGMS.Desktop.QueryOptionsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PGMS.Desktop" Title="Query Options" Width="640" Height="470" MinWidth="520" MinHeight="400" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F5F5F5">
 <Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <TreeView x:Name="Pages" Background="White" AutomationProperties.Name="Query option pages" SelectedItemChanged="PageChanged">
   <TreeViewItem Header="Execution" IsExpanded="True">
    <TreeViewItem x:Name="ExecutionGeneralNode" Header="General" Tag="0" IsSelected="True"/>
    <TreeViewItem x:Name="ExecutionAdvancedNode" Header="Advanced" Tag="1"/>
   </TreeViewItem>
   <TreeViewItem Header="Results" IsExpanded="True">
    <TreeViewItem x:Name="ResultsGridNode" Header="Grid" Tag="2"/>
    <TreeViewItem x:Name="ResultsTextNode" Header="Text" Tag="3"/>
   </TreeViewItem>
  </TreeView>
  <Border Grid.Column="1" Margin="10,0,0,0" Background="White" BorderBrush="#C8C8C8" BorderThickness="1" Padding="12,10">
   <local:QueryOptionsPages x:Name="OptionPages"/>
  </Border>
  <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
   <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="Accept" Padding="24,4"/>
   <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="8,0,0,0"/>
  </StackPanel>
 </Grid>
</Window>
