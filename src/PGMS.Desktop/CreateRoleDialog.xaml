<Window x:Class="PGMS.Desktop.CreateRoleDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="New Login/Group Role" Width="780" Height="680" MinWidth="700" MinHeight="600"
 Background="#F5F5F5" WindowStartupLocation="CenterOwner" Closing="DialogClosing">
 <Grid Margin="12">
  <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#B5C5D2" BorderThickness="1"><StackPanel><TextBlock Text="Select a page" FontWeight="SemiBold" Margin="9"/><Border Background="#D5E5EF" Padding="10,6"><TextBlock Text="General"/></Border></StackPanel></Border>
  <Grid Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="125"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="#E4EFF6" Padding="10" Margin="0,0,0,10"><StackPanel><TextBlock Text="New Login/Group Role" FontSize="18"/><TextBlock x:Name="Target" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
   <Grid Grid.Row="1" x:Name="Fields">
    <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Label Content="_Name:" Target="{Binding ElementName=RoleName}"/><TextBox x:Name="RoleName" Grid.Column="1" Grid.ColumnSpan="3" Height="25" VerticalAlignment="Top" Padding="4,2" TextChanged="InputChanged"/>
    <CheckBox x:Name="CanLogin" Grid.Row="1" Content="Can _login" IsChecked="True" Checked="InputChanged" Unchecked="InputChanged" VerticalAlignment="Center"/>
    <CheckBox x:Name="Inherit" Grid.Row="1" Grid.Column="1" Content="_Inherit privileges" IsChecked="True" Checked="InputChanged" Unchecked="InputChanged" VerticalAlignment="Center"/>
    <CheckBox x:Name="CreateDatabase" Grid.Row="1" Grid.Column="3" Content="Create _databases" Checked="InputChanged" Unchecked="InputChanged" VerticalAlignment="Center"/>
    <CheckBox x:Name="CreateRole" Grid.Row="2" Content="Create _roles" Checked="InputChanged" Unchecked="InputChanged" VerticalAlignment="Center"/>
    <CheckBox x:Name="Replication" Grid.Row="2" Grid.Column="1" Content="_Replication" Checked="InputChanged" Unchecked="InputChanged" VerticalAlignment="Center"/>
    <CheckBox x:Name="BypassRls" Grid.Row="2" Grid.Column="3" Content="Bypass _row security" Checked="InputChanged" Unchecked="InputChanged" VerticalAlignment="Center"/>
    <Label Grid.Row="3" Content="Connection _limit:" Target="{Binding ElementName=ConnectionLimit}"/><TextBox x:Name="ConnectionLimit" Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left" Height="25" Padding="4,2" Text="-1" TextChanged="InputChanged" ToolTip="-1 means no limit"/>
   </Grid>
   <TextBlock Grid.Row="2" Text="Authentication passwords are intentionally not collected or persisted in this milestone." Foreground="#4B5964" Margin="0,2,0,8" TextWrapping="Wrap"/>
   <TextBlock Grid.Row="3" Text="Member of" FontWeight="SemiBold" Margin="0,0,0,5"/>
   <ListBox Grid.Row="4" x:Name="Memberships" Background="White" BorderBrush="#B5C5D2" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Role memberships"/>
   <TextBlock Grid.Row="5" Text="Selected roles will be granted to the new role in the same transaction." Foreground="#4B5964" Margin="0,5,0,9"/>
   <Grid Grid.Row="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="SQL preview" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox Grid.Row="1" x:Name="SqlPreview" IsReadOnly="True" FontFamily="Consolas" FontSize="13" Background="White" BorderBrush="#B5C5D2" Padding="8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="SQL preview"/></Grid>
   <TextBlock Grid.Row="7" x:Name="Feedback" TextWrapping="Wrap" Foreground="#A4262C" Margin="0,8,0,2"/>
  </Grid>
  <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
   <TextBlock x:Name="Progress" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="ScriptButton" Content="_Script" Click="Script" Width="85" Margin="0,0,8,0" Padding="5" IsEnabled="False" ToolTip="Open this SQL in a query tab without executing"/>
    <Button x:Name="CreateButton" Content="_Create" Click="Create" Width="85" Margin="0,0,8,0" Padding="5" IsEnabled="False"/>
    <Button x:Name="CancelButton" Content="Cancel" Width="85" Padding="5" IsCancel="True"/>
   </StackPanel>
  </DockPanel>
 </Grid>
</Window>
