<Window x:Class="PGMS.Desktop.ConnectionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Connect to Server" Width="490" Height="680" MinWidth="440" MinHeight="360" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="#F5F5F5" Closing="OnClosing">
 <DockPanel Background="#F5F5F5">
  <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="24,8,24,16"><Button x:Name="CancelTestButton" Content="Cancel Test (_X)" Click="CancelTest" Visibility="Collapsed" Padding="4" Margin="0,0,8,0"/><Button x:Name="TestButton" Content="_Test" MinWidth="72" Margin="0,0,8,0" Padding="4" Click="TestConnection"/><Button x:Name="ConnectButton" Content="C_onnect" MinWidth="88" Margin="0,0,8,0" Padding="4" IsDefault="True" Click="Accept"/><Button Content="_Cancel" MinWidth="88" Padding="4" IsCancel="True"/></WrapPanel>
 <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#E4EFF6" BorderBrush="#B5C5D2" BorderThickness="0,0,0,1"><StackPanel Margin="24,14"><TextBlock Text="Postgres Management Studio" TextWrapping="Wrap" FontSize="21" Foreground="#294A60"/><TextBlock TextWrapping="Wrap" Text="Connect to a PostgreSQL server" Margin="0,4,0,0"/></StackPanel></Border>
  <StackPanel Grid.Row="1" Margin="24,12,24,0">
   <Label Target="{Binding ElementName=Profiles}"><AccessText Text="Saved pro_file:" TextWrapping="Wrap"/></Label>
   <DockPanel><Button x:Name="NewProfileButton" Content="N_ew" Click="NewProfile" DockPanel.Dock="Right" Padding="8,2" Margin="6,0,0,0"/><ComboBox x:Name="Profiles" SelectionChanged="SelectProfile" AutomationProperties.Name="Saved profiles"/></DockPanel>
   <Label Target="{Binding ElementName=ProfileName}"><AccessText Text="Profile _name:" TextWrapping="Wrap"/></Label><TextBox x:Name="ProfileName" AutomationProperties.Name="Profile name" Padding="4,2"/>
  </StackPanel>
  <Grid Grid.Row="2" Margin="24,16,24,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="34"/><RowDefinition Height="Auto" MinHeight="34"/><RowDefinition Height="Auto" MinHeight="34"/><RowDefinition Height="Auto" MinHeight="34"/><RowDefinition Height="Auto" MinHeight="34"/><RowDefinition Height="Auto" MinHeight="34"/><RowDefinition Height="Auto" MinHeight="34"/></Grid.RowDefinitions>
   <Label Target="{Binding ElementName=Host}"><AccessText Text="_Server name:" TextWrapping="Wrap"/></Label><TextBox x:Name="Host" AutomationProperties.Name="Server name" Grid.Column="1" Text="localhost" MinHeight="25" VerticalAlignment="Top" Padding="4,2"/>
   <Label Grid.Row="1" Target="{Binding ElementName=Port}"><AccessText Text="_Port:" TextWrapping="Wrap"/></Label><TextBox x:Name="Port" AutomationProperties.Name="Port" Grid.Row="1" Grid.Column="1" Text="5432" MinHeight="25" VerticalAlignment="Top" Padding="4,2"/>
   <Label Grid.Row="2" Target="{Binding ElementName=Database}"><AccessText Text="_Database:" TextWrapping="Wrap"/></Label><TextBox x:Name="Database" AutomationProperties.Name="Database" Grid.Row="2" Grid.Column="1" Text="postgres" MinHeight="25" VerticalAlignment="Top" Padding="4,2"/>
   <Label Grid.Row="3" Target="{Binding ElementName=Username}"><AccessText Text="_User name:" TextWrapping="Wrap"/></Label><TextBox x:Name="Username" AutomationProperties.Name="User name" Grid.Row="3" Grid.Column="1" Text="postgres" MinHeight="25" VerticalAlignment="Top" Padding="4,2"/>
   <Label Grid.Row="4" Target="{Binding ElementName=Password}"><AccessText Text="Pass_word:" TextWrapping="Wrap"/></Label><PasswordBox x:Name="Password" AutomationProperties.Name="Password" Grid.Row="4" Grid.Column="1" MinHeight="25" VerticalAlignment="Top" Padding="4,2"/>
   <Label Grid.Row="5" Target="{Binding ElementName=Ssl}"><AccessText Text="SS_L mode:" TextWrapping="Wrap"/></Label><ComboBox x:Name="Ssl" AutomationProperties.Name="SSL mode" Grid.Row="5" Grid.Column="1" MinHeight="25" VerticalAlignment="Top" SelectedIndex="0"><ComboBoxItem Content="VerifyFull"/><ComboBoxItem Content="Require"/><ComboBoxItem Content="Prefer"/><ComboBoxItem Content="Disable"/></ComboBox>
   <Label Grid.Row="6" Target="{Binding ElementName=RootCertificate}"><AccessText Text="Root certificate:" TextWrapping="Wrap"/></Label><DockPanel Grid.Row="6" Grid.Column="1" VerticalAlignment="Top"><Button x:Name="BrowseRootButton" Content="…" Click="BrowseRootCertificate" DockPanel.Dock="Right" Padding="8,2" Margin="6,0,0,0" AutomationProperties.Name="Browse root certificate"/><TextBox x:Name="RootCertificate" AutomationProperties.Name="Root certificate" MinHeight="25" Padding="4,2" ToolTip="Optional PEM file trusted for VerifyFull, such as a self-signed server certificate. Empty uses the Windows trust store."/></DockPanel>
  </Grid>
  <StackPanel Grid.Row="3" Margin="24,0,24,16"><CheckBox x:Name="RememberPassword" ><AccessText Text="Save password for this Windows user (_M)" TextWrapping="Wrap"/></CheckBox><CheckBox x:Name="DisableHistory" Margin="0,4,0,0" AutomationProperties.Name="Do not record query history for this server" ToolTip="Saved with the profile. Query History then records nothing that runs on this server and port, whatever database or profile the query tab used. Off by default."><AccessText Text="Do not record query _history for this server" TextWrapping="Wrap"/></CheckBox><TextBlock Text="Save Profile stores settings locally. Password saving is optional and protected by Windows DPAPI. Connect does not save changes." Foreground="#4B5964" TextWrapping="Wrap" Margin="0,2,0,0"/><WrapPanel Margin="0,8,0,0"><Button x:Name="SaveProfileButton" Content="Sa_ve Profile" Click="SaveProfile" Padding="8,3"/><Button x:Name="DeleteProfileButton" Content="Delete P_rofile…" Click="DeleteProfile" Padding="8,3" Margin="8,0" IsEnabled="False"/></WrapPanel><TextBlock x:Name="Error" Foreground="#A4262C" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>

 </Grid>
 </ScrollViewer>
 </DockPanel>
</Window>
