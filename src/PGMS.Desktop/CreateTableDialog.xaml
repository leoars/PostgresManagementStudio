<Window x:Class="PGMS.Desktop.CreateTableDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PGMS.Desktop" Title="New Table" Width="800" Height="780" MinWidth="710" MinHeight="710" Background="#F5F5F5" WindowStartupLocation="CenterOwner" Closing="OnClosing">
 <Window.Resources><local:ColumnIdentityTextConverter x:Key="IdentityText"/></Window.Resources>
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="120"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#E4EFF6" Padding="10" Margin="0,0,0,12"><TextBlock x:Name="Target" TextWrapping="Wrap"/></Border>
  <Grid x:Name="Names" Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Label Content="Schema:" Target="{Binding ElementName=SchemaName}"/><TextBox x:Name="SchemaName" Text="public" Padding="4" TextChanged="Changed"/></StackPanel><StackPanel Grid.Column="2"><Label Content="Table name:" Target="{Binding ElementName=TableName}"/><TextBox x:Name="TableName" Padding="4" TextChanged="Changed"/></StackPanel></Grid>
  <DataGrid local:DataGridRowNames.Enabled="True" Grid.Row="2" x:Name="ColumnGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" AutomationProperties.Name="Table columns"><DataGrid.Columns><DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="*" MinWidth="190"/><DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="160"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding TypeDisplay}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridCheckBoxColumn Header="Nullable" Binding="{Binding Nullable}" Width="80"/><DataGridTextColumn Header="Identity" Binding="{Binding Identity,Converter={StaticResource IdentityText}}" Width="130"/></DataGrid.Columns></DataGrid>
  <ScrollViewer Grid.Row="3" x:Name="ColumnFields" Margin="0,10" MaxHeight="220" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Add a column (remove and add again to change it):"/><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="85"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ColumnName" Padding="4" AutomationProperties.Name="New column name"/><ComboBox x:Name="DataType" Grid.Column="1" Margin="8,0" SelectionChanged="ColumnOptionsChanged" AutomationProperties.Name="Column data type"/><CheckBox x:Name="Nullable" Grid.Column="2" Content="Nullable" IsChecked="True" VerticalAlignment="Center"/><Button x:Name="AddButton" Grid.Column="3" Content="Add" Click="AddColumn" Padding="10,3"/><Button x:Name="RemoveButton" Grid.Column="4" Content="Remove" Click="RemoveColumn" Padding="10,3" Margin="8,0,0,0"/></Grid>
   <DockPanel Margin="0,3,0,0"><Label Content="_Identity generation:" Target="{Binding ElementName=IdentitySelector}"/><ComboBox x:Name="IdentitySelector" Width="180" HorizontalAlignment="Left" SelectionChanged="ColumnOptionsChanged" AutomationProperties.Name="New column identity generation"/></DockPanel>
   <DockPanel Margin="0,8,0,0"><Button x:Name="CatalogTypeButton" Content="Catalog type…" Click="ChooseCatalogType" Padding="10,3" DockPanel.Dock="Left"/><Button x:Name="ClearTypeButton" Content="Use built-in" Click="ClearCatalogType" Padding="10,3" Margin="8,0" DockPanel.Dock="Right"/><TextBlock x:Name="CatalogTypeLabel" Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="Selected catalog column type"/></DockPanel>
   <TextBlock x:Name="IdentityHelp" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.Name="Identity generation guidance"/>
   <Expander x:Name="PartitionOptions" Header="Partitioning" Margin="0,8,0,0">
    <StackPanel>
     <DockPanel><Label Content="_Strategy:" Target="{Binding ElementName=PartitionStrategySelector}"/><ComboBox x:Name="PartitionStrategySelector" Width="160" HorizontalAlignment="Left" SelectionChanged="Changed" AutomationProperties.Name="Partition strategy"/></DockPanel>
     <StackPanel x:Name="PartitionKeyFields">
      <DockPanel Margin="0,5"><Button x:Name="AddKeyButton" DockPanel.Dock="Right" Content="Add key" Click="AddPartitionKey" Padding="10,3"/><Label Content="_Column:" Target="{Binding ElementName=PartitionColumn}"/><ComboBox x:Name="PartitionColumn" AutomationProperties.Name="Declared partition key column"/></DockPanel>
      <DockPanel><StackPanel DockPanel.Dock="Right" Margin="8,0,0,0"><Button x:Name="MoveKeyButton" Content="Move up" Click="MovePartitionKey" Padding="10,3"/><Button x:Name="RemoveKeyButton" Content="Remove key" Click="RemovePartitionKey" Padding="10,3" Margin="0,4,0,0"/></StackPanel><ListBox x:Name="PartitionKeys" Height="60" AutomationProperties.Name="Ordered partition keys"/></DockPanel>
      <TextBlock Text="Keys are used in this order. LIST requires one; RANGE and HASH allow up to 32. Removing a declared key column requires reviewing the keys again." TextWrapping="Wrap" Margin="0,5"/>
     </StackPanel>
    </StackPanel>
   </Expander>
  </StackPanel></ScrollViewer>
  <TextBox Grid.Row="4" x:Name="Preview" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" AutomationProperties.Name="SQL preview"/>
  <TextBlock Grid.Row="5" x:Name="Feedback" TextWrapping="Wrap" Margin="0,8"/>
  <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ScriptButton" Content="Script" Click="Script" Padding="16,5"/><Button x:Name="ApplyButton" Content="Create" Click="Apply" Padding="16,5" Margin="8,0"/><Button x:Name="CloseButton" Content="Close" IsCancel="True" Padding="16,5"/></StackPanel>
 </Grid>
</Window>
