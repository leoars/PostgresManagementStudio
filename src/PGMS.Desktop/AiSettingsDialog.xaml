<Window x:Class="PGMS.Desktop.AiSettingsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI Assistant Settings" Width="640" Height="560" MinWidth="560" MinHeight="500" Background="#F5F5F5" WindowStartupLocation="CenterOwner" Closing="OnClosing">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#E4EFF6" Padding="10" Margin="0,0,0,10"><TextBlock TextWrapping="Wrap" Text="AI Assistant&#10;API keys are encrypted for this Windows user (DPAPI) and stored only on this computer. They are never written to connection profiles, logs or scripts."/></Border>
  <Grid x:Name="Fields" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="34"/><RowDefinition Height="Auto" MinHeight="34"/><RowDefinition Height="Auto" MinHeight="34"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto" MinHeight="34"/></Grid.RowDefinitions>
   <Label Content="Provider:" Target="{Binding ElementName=Provider}"/><ComboBox x:Name="Provider" Grid.Column="1" SelectionChanged="ProviderChanged" VerticalAlignment="Top" MinHeight="25" AutomationProperties.Name="Provider"/>
   <Label Grid.Row="1" Content="Address:" Target="{Binding ElementName=Endpoint}"/><TextBox x:Name="Endpoint" Grid.Row="1" Grid.Column="1" TextChanged="Changed" VerticalAlignment="Top" MinHeight="25" Padding="4,2" AutomationProperties.Name="Provider address"/>
   <Label Grid.Row="2" x:Name="KeyLabel" Content="API key:" Target="{Binding ElementName=Key}"/><PasswordBox x:Name="Key" Grid.Row="2" Grid.Column="1" PasswordChanged="Changed" VerticalAlignment="Top" MinHeight="25" Padding="4,2" AutomationProperties.Name="API key"/><Button x:Name="RemoveKeyButton" Grid.Row="2" Grid.Column="2" Content="Remove Key…" Click="RemoveKey" VerticalAlignment="Top" Padding="10,3" Margin="8,0,0,0"/>
   <TextBlock x:Name="KeyStatus" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Foreground="#4B5964" Margin="0,0,0,8"/>
   <Label Grid.Row="4" Content="Model:" Target="{Binding ElementName=Model}"/><ComboBox x:Name="Model" Grid.Row="4" Grid.Column="1" IsEditable="True" VerticalAlignment="Top" MinHeight="25" AutomationProperties.Name="Model"/><Button x:Name="TestButton" Grid.Row="4" Grid.Column="2" Content="Test Connection" Click="Test" VerticalAlignment="Top" Padding="10,3" Margin="8,0,0,0"/>
  </Grid>
  <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="0,12,0,0" Text="The provider selected here is the one the query assistant uses. The assistant sends only the database structure of the current connection (schemas, tables, columns, types, keys and comments) and your request; never table data. Generated SQL is only inserted into the editor; it is never executed by the assistant. Test Connection lists the provider's models without generating text."/>
  <TextBlock Grid.Row="3" x:Name="Feedback" TextWrapping="Wrap" Margin="0,10"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SaveButton" Content="Save" Click="Save" Padding="16,5" IsDefault="True"/><Button x:Name="CloseButton" Content="Close" IsCancel="True" Padding="16,5" Margin="8,0,0,0"/></StackPanel>
 </Grid>
</Window>
