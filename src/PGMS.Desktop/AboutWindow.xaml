<Window x:Class="PGMS.Desktop.AboutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="About PGMS" Icon="Resources/PGMS.ico" Width="640" Height="540" MinWidth="560" MinHeight="480"
 Background="{StaticResource PanelBrush}" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
 <DockPanel>
  <Border DockPanel.Dock="Bottom" BorderBrush="#B5C5D2" BorderThickness="0,1,0,0" Padding="20,12">
   <Button Content="Close" Width="88" Padding="8,5" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="CloseAbout"/>
  </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="28,18,28,22">
    <Image Source="Resources/PGMS-logo.png" Width="480" Height="180" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="PGMS — Postgres Management Studio"/>
    <TextBlock x:Name="Milestone" FontWeight="SemiBold" Margin="0,8,0,12"/>
    <TextBlock Text="Queries, object navigation and PostgreSQL administration." TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="C# / WPF / .NET 10"/>
    <TextBlock Text="AvalonDock · AvalonEdit · Npgsql" Margin="0,3,0,16"/>
    <TextBlock Text="Development build. Supported workflows and limitations are still under review; full SSMS parity is not claimed." TextWrapping="Wrap" Margin="0,0,0,16"/>
    <TextBlock Text="PGMS is an independent project and is not affiliated with the PostgreSQL project." TextWrapping="Wrap" Foreground="#4B5964" Margin="0,0,0,8"/>
    <TextBlock Text="PostgreSQL and the Slonik elephant logo are trademarks or registered trademarks of the PostgreSQL Community Association of Canada." TextWrapping="Wrap" Foreground="#4B5964"/>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
