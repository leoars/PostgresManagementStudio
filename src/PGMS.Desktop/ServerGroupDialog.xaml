<Window x:Class="PGMS.Desktop.ServerGroupDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="New Server Group" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F5F5F5">
 <StackPanel Margin="12">
  <TextBlock x:Name="ParentText" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <Label Content="Group _name:" Target="{Binding ElementName=GroupName}" Padding="0,0,0,3"/>
  <TextBox x:Name="GroupName" Padding="3" MaxLength="128" AutomationProperties.Name="Group name"/>
  <TextBlock x:Name="Error" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,6,0,0"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
   <Button Content="OK" IsDefault="True" Click="Accept" Padding="16,4"/>
   <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="8,0,0,0"/>
  </StackPanel>
 </StackPanel>
</Window>
