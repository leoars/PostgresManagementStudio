<Window x:Class="PGMS.Desktop.DefaultPrivilegeDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Default Permissions" Width="760" Height="700" MinWidth="650" MinHeight="520" Background="#F5F5F5" WindowStartupLocation="CenterOwner" Closing="OnClosing" PreviewKeyDown="OnKey">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
   <StackPanel>
    <Border Background="#E4EFF6" Padding="10" Margin="0,0,0,10"><TextBlock x:Name="Target" TextWrapping="Wrap"/></Border>
    <TextBlock Text="Permissions for future objects created by the selected role. Existing objects are unchanged. Schema policies add to global defaults; they cannot remove global permissions." TextWrapping="Wrap" Margin="0,0,0,10"/>
    <Grid x:Name="Fields"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><DockPanel><Button x:Name="LoadCreatorsButton" Content="_Load roles" DockPanel.Dock="Right" Click="LoadCreators" Padding="8,2"/><Label Content="_Creator role" Target="{Binding ElementName=Creator}"/></DockPanel><ComboBox x:Name="Creator" IsEditable="True" DisplayMemberPath="Name" TextSearch.TextPath="Name" AutomationProperties.Name="Future object creator" SelectionChanged="ScopeChanged"/></StackPanel>
     <StackPanel Grid.Column="2"><Label Content="O_bject class" Target="{Binding ElementName=ObjectClass}"/><ComboBox x:Name="ObjectClass" AutomationProperties.Name="Future object class" SelectionChanged="ClassChanged"/></StackPanel>
     <StackPanel Grid.Row="1"><CheckBox x:Name="GlobalScope" Content="_Database-wide defaults" Margin="0,10,0,4" IsChecked="True" Checked="ScopeChanged" Unchecked="ScopeChanged"/><Label Content="Sc_hema (exact name)" Target="{Binding ElementName=SchemaName}"/><TextBox x:Name="SchemaName" Text="public" AutomationProperties.Name="Default permission schema" TextChanged="ScopeChanged"/></StackPanel>
     <StackPanel Grid.Row="1" Grid.Column="2"><CheckBox x:Name="PublicRecipient" Content="All roles (P_UBLIC)" Margin="0,10,0,4" Checked="Changed" Unchecked="Changed"/><Label Content="_Recipient role (exact name)" Target="{Binding ElementName=RoleName}"/><TextBox x:Name="RoleName" AutomationProperties.Name="Default permission recipient" TextChanged="Changed"/></StackPanel>
     <StackPanel Grid.Row="2"><Label Content="_Privilege" Target="{Binding ElementName=Privilege}"/><ComboBox x:Name="Privilege" AutomationProperties.Name="Default privilege" SelectionChanged="Changed"/></StackPanel>
     <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0"><CheckBox x:Name="Revoke" Content="Revo_ke (RESTRICT)" Margin="0,4" Checked="Changed" Unchecked="Changed"/><CheckBox x:Name="GrantOption" Content="Grant _option only" ToolTip="Grant: allow delegation. Revoke: remove delegation only, preserving the base permission." Checked="Changed" Unchecked="Changed"/></StackPanel>
    </Grid>
    <TabControl x:Name="PolicyTabs" Margin="0,12,0,0" Height="240">
     <TabItem Header="SQL preview"><TextBox x:Name="Preview" IsReadOnly="True" FontFamily="Consolas" Padding="8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Default permission SQL preview"/></TabItem>
     <TabItem Header="Policy origins"><Grid Margin="4"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="PolicyRows" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="RowChanged" AutomationProperties.Name="Default permission policy entries"><DataGrid.Columns><DataGridTextColumn Header="Origin" Binding="{Binding Origin}"/><DataGridTextColumn Header="Recipient" Binding="{Binding Recipient}" MaxWidth="180"/><DataGridTextColumn Header="Privilege" Binding="{Binding Privilege}"/><DataGridCheckBoxColumn Header="Grant option" Binding="{Binding Grantable}"/><DataGridTextColumn Header="Grantor" Binding="{Binding Grantor}" MaxWidth="180"/></DataGrid.Columns></DataGrid><TextBox Grid.Row="1" x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Complete selected policy names and identities"/></Grid></TabItem>
    </TabControl>
   </StackPanel>
  </ScrollViewer>
  <TextBlock Grid.Row="1" x:Name="Feedback" TextWrapping="Wrap" Margin="0,8" AutomationProperties.LiveSetting="Polite"/>
  <DockPanel Grid.Row="2" LastChildFill="False"><Button x:Name="InspectButton" Content="_Inspect" Click="Inspect" Padding="12,5"/><Button x:Name="CancelButton" Content="C_ancel operation" Click="Cancel" Visibility="Collapsed" Padding="10,5" Margin="8,0"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ScriptButton" Content="_Script" Click="Script" Padding="14,5"/><Button x:Name="ApplyButton" Content="_Apply" Click="Apply" Padding="14,5" Margin="8,0"/><Button x:Name="CloseButton" Content="Close" Click="CloseClick" Padding="14,5"/></StackPanel></DockPanel>
 </Grid>
</Window>
