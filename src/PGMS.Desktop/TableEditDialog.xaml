<Window x:Class="PGMS.Desktop.TableEditDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pg="clr-namespace:PGMS.PostgreSql;assembly=PGMS.PostgreSql" Title="Table Operations" Width="760" Height="820" MinWidth="680" MinHeight="760" Background="#F5F5F5" WindowStartupLocation="CenterOwner" Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#E4EFF6" Padding="10" Margin="0,0,0,10"><TextBlock x:Name="Target" TextWrapping="Wrap"/></Border>
  <StackPanel x:Name="Fields" Grid.Row="1">
   <Label Content="_Operation:" Target="{Binding ElementName=Operation}"/><ComboBox x:Name="Operation" SelectionChanged="Changed" Padding="4" AutomationProperties.Name="Operation"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding}"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Static pg:TableOperation.Rename}"><Setter Property="Text" Value="Rename Table"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static pg:TableOperation.Drop}"><Setter Property="Text" Value="Drop Table"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static pg:TableOperation.AddColumn}"><Setter Property="Text" Value="Add Column"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static pg:TableOperation.RenameColumn}"><Setter Property="Text" Value="Rename Column"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static pg:TableOperation.DropColumn}"><Setter Property="Text" Value="Drop Column"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static pg:TableOperation.SetNotNull}"><Setter Property="Text" Value="Set NOT NULL"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static pg:TableOperation.DropNotNull}"><Setter Property="Text" Value="Drop NOT NULL"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static pg:TableOperation.SetDefault}"><Setter Property="Text" Value="Set Literal Default"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static pg:TableOperation.DropDefault}"><Setter Property="Text" Value="Drop Default"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static pg:TableOperation.SetSchema}"><Setter Property="Text" Value="Move to Schema"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static pg:TableOperation.CommentTable}"><Setter Property="Text" Value="Table Comment"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static pg:TableOperation.CommentColumn}"><Setter Property="Text" Value="Column Comment"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Label Content="Sc_hema:" Target="{Binding ElementName=SchemaName}"/><TextBox x:Name="SchemaName" Padding="4" TextChanged="Changed" AutomationProperties.Name="Schema"/></StackPanel><StackPanel Grid.Column="2"><Label Content="_Table:" Target="{Binding ElementName=TableName}"/><TextBox x:Name="TableName" Padding="4" TextChanged="Changed" AutomationProperties.Name="Table"/></StackPanel></Grid>
   <DockPanel Margin="0,0,0,6"><Button x:Name="InspectTargetButton" Content="_Inspect Target" Click="InspectTarget" Padding="10,4" DockPanel.Dock="Left"/><TextBlock x:Name="SnapshotStatus" Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
   <StackPanel x:Name="ColumnFields"><ComboBox x:Name="ColumnPicker" DisplayMemberPath="Name" SelectionChanged="PickColumn" Padding="4" AutomationProperties.Name="Inspected columns" ToolTip="Choose an inspected column"/><Label Content="Column name:" Target="{Binding ElementName=ColumnName}"/><TextBox x:Name="ColumnName" Padding="4" TextChanged="Changed" AutomationProperties.Name="Column name"/><TextBlock x:Name="InspectedColumnType" TextWrapping="Wrap" Margin="0,4,0,0"/><WrapPanel><Button x:Name="IdentityOperationsButton" Content="Identity operations…" Click="OpenIdentityOperations" HorizontalAlignment="Left" Padding="10,4" Margin="0,4" Visibility="Collapsed" AutomationProperties.Name="Open inspected column identity operations"/><Button x:Name="TypeOperationsButton" Content="Change type…" Click="OpenTypeOperations" Padding="10,4" Margin="8,4,0,4" Visibility="Collapsed" AutomationProperties.Name="Change inspected column type"/></WrapPanel></StackPanel>
   <StackPanel x:Name="InspectedColumnStateFields"><Label x:Name="InspectedColumnStateLabel" Content="Inspected default expression:" Target="{Binding ElementName=InspectedColumnState}"/><TextBox x:Name="InspectedColumnState" IsReadOnly="True" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="4" AutomationProperties.Name="Inspected column state"/></StackPanel>
   <StackPanel x:Name="NewNameFields"><Label x:Name="NewNameLabel" Content="New name:" Target="{Binding ElementName=NewName}"/><TextBox x:Name="NewName" Padding="4" TextChanged="Changed" AutomationProperties.Name="{Binding Content, ElementName=NewNameLabel}"/>
    <StackPanel x:Name="DestinationSchemasFields" Margin="0,6,0,0"><DockPanel><Button x:Name="LoadSchemasButton" Content="_Load Schemas" Click="LoadSchemas" Padding="10,4" Margin="0,0,8,0"/><ComboBox x:Name="DestinationSchemaPicker" SelectionChanged="PickDestinationSchema" Padding="4" AutomationProperties.Name="Destination schema"/></DockPanel><TextBlock x:Name="SchemaLoadStatus" Text="Load schemas from this database or enter an exact name. Permissions are checked on Apply." TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
   </StackPanel>
   <StackPanel x:Name="DefaultFields"><Label Content="Default literal value:" Target="{Binding ElementName=DefaultValue}"/><TextBox x:Name="DefaultValue" Padding="4" TextChanged="Changed" MaxLength="10000" AutomationProperties.Name="Default literal value"/></StackPanel>
   <StackPanel x:Name="CommentFields"><Button x:Name="LoadCommentButton" Content="_Load Inspected Comment" Click="LoadComment" HorizontalAlignment="Left" Padding="10,4" Margin="0,4"/><Label Content="Comment text:" Target="{Binding ElementName=CommentText}"/><TextBox x:Name="CommentText" Padding="4" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="10000" TextChanged="Changed" AutomationProperties.Name="Comment text"/><CheckBox x:Name="RemoveComment" Content="Remove existing comment" Margin="0,8" Checked="Changed" Unchecked="Changed"/></StackPanel>
   <StackPanel x:Name="TypeFields"><Label Content="Column type:" Target="{Binding ElementName=ColumnTypeSelector}"/><DockPanel><Button x:Name="AddCatalogColumnButton" Content="Catalog column…" Click="AddCatalogColumn" Padding="10,4" Margin="8,0,0,0" DockPanel.Dock="Right" ToolTip="Inspect the table, then add a column using a catalog type"/><ComboBox x:Name="ColumnTypeSelector" Padding="4" SelectionChanged="Changed" AutomationProperties.Name="Column type"/></DockPanel><CheckBox x:Name="AllowNull" Content="Allow NULL" IsChecked="True" Margin="0,8" Checked="Changed" Unchecked="Changed"/>
    <Label Content="Identity _generation:" Target="{Binding ElementName=IdentitySelector}"/><ComboBox x:Name="IdentitySelector" Padding="4" SelectionChanged="Changed" AutomationProperties.Name="Added column identity generation"/>
    <TextBlock x:Name="IdentityHelp" TextWrapping="Wrap" Margin="0,6" AutomationProperties.Name="Identity generation guidance"/>
   </StackPanel>
  </StackPanel>
  <TextBox Grid.Row="2" x:Name="Preview" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" Margin="0,8,0,0" AutomationProperties.Name="SQL preview"/>
  <TextBlock Grid.Row="3" x:Name="Feedback" TextWrapping="Wrap" Margin="0,8"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelInspectionButton" Content="Cancel Ins_pection" Click="CancelInspection" IsEnabled="False" Padding="12,5" Margin="0,0,12,0"/><Button x:Name="ScriptButton" Content="_Script" Click="Script" Padding="16,5"/><Button x:Name="ApplyButton" Content="_Apply" Click="Apply" Padding="16,5" Margin="8,0"/><Button x:Name="CloseButton" Content="_Close" IsCancel="True" Padding="16,5"/></StackPanel>
 </Grid>
</Window>
