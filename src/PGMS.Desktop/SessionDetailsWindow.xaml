<Window x:Class="PGMS.Desktop.SessionDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="620" Height="440" MinWidth="460" MinHeight="320" Background="#F5F5F5" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" Closing="OnClosing">
 <DockPanel Margin="12">
  <Grid x:Name="Facts" DockPanel.Dock="Top" Margin="0,0,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
   <TextBlock Text="Database:" Margin="0,0,6,4"/><TextBlock x:Name="DatabaseValue" Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0,0,12,4"/>
   <TextBlock Grid.Column="2" Text="Application:" Margin="0,0,6,4"/><TextBlock x:Name="ApplicationValue" Grid.Column="3" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
   <TextBlock Grid.Row="1" Text="Host:" Margin="0,0,6,4"/><TextBlock x:Name="HostValue" Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0,0,12,4"/>
   <TextBlock Grid.Row="1" Grid.Column="2" Text="State:" Margin="0,0,6,4"/><TextBlock x:Name="StateValue" Grid.Row="1" Grid.Column="3" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
   <TextBlock Grid.Row="2" Text="Backend start:" Margin="0,0,6,4"/><TextBlock x:Name="BackendStartValue" Grid.Row="2" Grid.Column="1" Margin="0,0,12,4"/>
   <TextBlock Grid.Row="2" Grid.Column="2" Text="Wait:" Margin="0,0,6,4"/><TextBlock x:Name="WaitValue" Grid.Row="2" Grid.Column="3" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
   <TextBlock Grid.Row="3" Text="Blocked by PID:" Margin="0,0,6,0"/><TextBlock x:Name="BlockersValue" Grid.Row="3" Grid.Column="1" Margin="0,0,12,0"/>
   <TextBlock Grid.Row="3" Grid.Column="2" Text="Head blocker:" Margin="0,0,6,0"/><TextBlock x:Name="HeadBlockerValue" Grid.Row="3" Grid.Column="3"/>
  </Grid>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
   <Button x:Name="TerminateButton" Content="Terminate Session…" Click="Terminate" Padding="12,4" Margin="0,0,8,0"/>
   <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh" Padding="12,4" MinWidth="80" Margin="0,0,8,0"/>
   <Button x:Name="CloseButton" Content="Close" Click="CloseClicked" IsCancel="True" IsDefault="True" Padding="12,4" MinWidth="80"/>
  </StackPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.Name="Session details status"/>
  <GroupBox Header="Most recent query (running now when the state is active)">
   <TextBox x:Name="QueryText" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="0,4,0,0" AutomationProperties.Name="Most recent query text" ToolTip="The server truncates this text at track_activity_query_size bytes."/>
  </GroupBox>
 </DockPanel>
</Window>
