<Window x:Class="PGMS.Desktop.ServerPropertiesDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="900" Height="640" MinWidth="700" MinHeight="480" Background="#F5F5F5" WindowStartupLocation="CenterOwner">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Background="#F0F0F0">
   <TextBlock DockPanel.Dock="Top" Text="Select a page" FontWeight="SemiBold" Background="#DCE6F0" Padding="6,4"/>
   <StackPanel DockPanel.Dock="Bottom" Margin="6,8"><TextBlock Text="Connection" FontWeight="SemiBold" Background="#DCE6F0" Padding="0,4"/><TextBlock x:Name="ConnectionInfo" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
   <ListBox x:Name="Pages" BorderThickness="0" Background="Transparent" SelectionChanged="PageChanged" AutomationProperties.Name="Pages"/>
  </DockPanel>
  <Grid Grid.Column="1" Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel x:Name="FilterPanel" Margin="0,0,0,8" Visibility="Collapsed"><Label Content="Filter:" Target="{Binding ElementName=Filter}"/><CheckBox x:Name="ChangedOnly" Content="Changed from default only" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" Checked="FilterChanged" Unchecked="FilterChanged"/><TextBox x:Name="Filter" TextChanged="FilterChanged" Padding="4" AutomationProperties.Name="Filter settings"/></DockPanel>
   <DataGrid x:Name="Properties" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="RowChanged" CanUserAddRows="False" GridLinesVisibility="Horizontal" AutomationProperties.Name="Server properties">
    <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns>
   </DataGrid>
   <DataGrid x:Name="Settings" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="RowChanged" CanUserAddRows="False" GridLinesVisibility="Horizontal" Visibility="Collapsed" EnableRowVirtualization="True" AutomationProperties.Name="Server settings">
    <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="230"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="50"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110"/><DataGridCheckBoxColumn Header="Restart pending" Binding="{Binding PendingRestart}" Width="100"/></DataGrid.Columns>
   </DataGrid>
   <Border Grid.Row="2" BorderBrush="#B5C5D2" BorderThickness="1" Background="White" Padding="8" Margin="0,8,0,0" MinHeight="54"><StackPanel><TextBlock x:Name="DescriptionTitle" FontWeight="SemiBold"/><TextBlock x:Name="Description" TextWrapping="Wrap"/></StackPanel></Border>
   <TextBlock Grid.Row="3" x:Name="Feedback" TextWrapping="Wrap" Margin="0,8,0,0" Text="Read-only. To change a setting, run ALTER SYSTEM in a query window and use Reload Configuration (settings marked as needing a restart apply only after one)."/>
  </Grid>
  <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10"><Button x:Name="RefreshButton" Content="Refresh" Click="Refresh" Padding="16,5"/><Button Content="Close" IsCancel="True" IsDefault="True" Padding="16,5" Margin="8,0,0,0"/></StackPanel>
 </Grid>
</Window>
