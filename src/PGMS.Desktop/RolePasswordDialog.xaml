<Window x:Class="PGMS.Desktop.RolePasswordDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Set Role Password" Width="680" Height="520" MinWidth="620" MinHeight="460" Background="#F5F5F5" WindowStartupLocation="CenterOwner" Closing="OnClosing">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#E4EFF6" Padding="10" Margin="0,0,0,10"><TextBlock x:Name="Target" TextWrapping="Wrap"/></Border>
  <StackPanel x:Name="Fields" Grid.Row="1"><Label Content="Role name (exact):"/><DockPanel><Button x:Name="InspectButton" Content="Inspect roles" Click="Inspect" DockPanel.Dock="Right" Padding="12,3" Margin="8,0,0,0"/><TextBox x:Name="RoleName" TextChanged="Changed" Padding="4"/></DockPanel><Label Content="New password:" Margin="0,8,0,0"/><PasswordBox x:Name="Password" PasswordChanged="Changed" Padding="4"/><Label Content="Confirm password:" Margin="0,8,0,0"/><PasswordBox x:Name="ConfirmPassword" PasswordChanged="Changed" Padding="4"/><CheckBox x:Name="AllowUnencrypted" Content="Allow sending without TLS (the password verifier crosses the network unencrypted)" Checked="Changed" Unchecked="Changed" Margin="0,10,0,0"/></StackPanel>
  <TextBlock Grid.Row="2" Text="Unicode passwords are supported. Characters with incompatible PostgreSQL and driver mappings are refused before any change. The secret is never included in SQL preview, a Script tab, or saved profiles. TLS is required (SSL Mode Require or certificate validation), except on loopback connections or when sending without TLS is explicitly allowed." TextWrapping="Wrap" Margin="0,10"/>
  <TextBlock Grid.Row="3" x:Name="Feedback" TextWrapping="Wrap" Margin="0,8"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ApplyButton" Content="Apply" Click="Apply" Padding="16,5"/><Button x:Name="CloseButton" Content="Close" IsCancel="True" Padding="16,5" Margin="8,0"/></StackPanel>
 </Grid>
</Window>
