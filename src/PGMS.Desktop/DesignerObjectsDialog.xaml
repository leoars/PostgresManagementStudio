<Window x:Class="PGMS.Desktop.DesignerObjectsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PGMS.Desktop"
  Width="650" Height="415" MinWidth="560" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" Background="#F0F0F0">
 <Grid Margin="12,10,12,12">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="186" MinWidth="120"/><ColumnDefinition Width="14"/><ColumnDefinition MinWidth="300"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="68"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="ListCaption" Grid.ColumnSpan="3" Margin="0,0,0,6"/>
  <ListBox x:Name="Items" Grid.Row="1" Grid.RowSpan="2" DisplayMemberPath="DisplayName" SelectionChanged="SelectionChanged" AutomationProperties.Name="Items"/>
  <Border Grid.Row="1" Grid.Column="2" BorderBrush="#C8C8C8" BorderThickness="0,1,0,1" Background="#EFEFEF" Padding="6,4" Margin="0,0,0,10">
   <TextBlock x:Name="Help" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </Border>
  <!-- Drag to widen the list, so long names show whole. -->
  <GridSplitter x:Name="ListSplitter" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="14" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Focusable="False" AutomationProperties.Name="Resize list"/>
  <local:DesignerPropertyGrid x:Name="Properties" Grid.Row="2" Grid.Column="2"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
   <Button x:Name="AddButton" Content="_Add" Width="86" Height="24" Margin="0,0,8,0" Click="AddItem"/>
   <Button x:Name="DeleteButton" Content="_Delete" Width="86" Height="24" Click="DeleteItem"/>
  </StackPanel>
  <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
   <Button x:Name="CloseButton" Content="_Close" Width="86" Height="24" IsCancel="True" IsDefault="True" Click="CloseDialog"/>
  </StackPanel>
 </Grid>
</Window>
