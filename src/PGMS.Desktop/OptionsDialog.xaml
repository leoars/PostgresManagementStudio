<Window x:Class="PGMS.Desktop.OptionsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PGMS.Desktop" Title="Options" Width="680" Height="480" MinWidth="560" MinHeight="400" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F5F5F5">
 <Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <TreeView x:Name="Pages" Background="White" AutomationProperties.Name="Option pages" SelectedItemChanged="PageChanged">
   <TreeViewItem Header="Environment" IsExpanded="True">
    <TreeViewItem x:Name="GeneralPage" Header="General" IsSelected="True"/>
   </TreeViewItem>
   <TreeViewItem Header="Query Execution" IsExpanded="True">
    <TreeViewItem x:Name="ExecutionGeneralPage" Header="General"/>
    <TreeViewItem x:Name="ExecutionAdvancedPage" Header="Advanced"/>
   </TreeViewItem>
   <TreeViewItem Header="Query Results" IsExpanded="True">
    <TreeViewItem x:Name="QueryResultsPage" Header="General"/>
    <TreeViewItem x:Name="ResultsGridPage" Header="Grid"/>
    <TreeViewItem x:Name="ResultsTextPage" Header="Text"/>
   </TreeViewItem>
   <TreeViewItem Header="Object Explorer" IsExpanded="True">
    <TreeViewItem x:Name="CommandsPage" Header="Commands"/>
   </TreeViewItem>
  </TreeView>
  <Border Grid.Column="1" Margin="10,0,0,0" Background="White" BorderBrush="#C8C8C8" BorderThickness="1" Padding="12,10">
   <Grid>
    <StackPanel x:Name="GeneralPanel">
     <TextBlock Text="Window" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <CheckBox x:Name="RestoreWindowBox" Content="_Restore window size and position at startup"/>
     <TextBlock Text="When this is on, PGMS opens with the size and position it had when it was closed, maximized if it was maximized." TextWrapping="Wrap" Foreground="#5A5A5A" Margin="20,4,0,0"/>
    </StackPanel>
    <StackPanel x:Name="QueryResultsPanel" Visibility="Collapsed">
     <TextBlock Text="General" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
      <Label Content="_Default destination for results:" Target="{Binding ElementName=DefaultResultsBox}" Padding="0" VerticalAlignment="Center"/>
      <ComboBox x:Name="DefaultResultsBox" Grid.Column="1" AutomationProperties.Name="Default destination for results">
       <ComboBoxItem Content="Results to grid" Tag="Grid"/><ComboBoxItem Content="Results to text" Tag="Text"/><ComboBoxItem Content="Results to file" Tag="File"/>
      </ComboBox>
     </Grid>
     <TextBlock Text="Used by query windows opened from now on. Query ▸ Results To changes only the active query window." TextWrapping="Wrap" Foreground="#5A5A5A" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel x:Name="CommandsPanel" Visibility="Collapsed">
     <TextBlock Text="Table and View Options" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Label Content="Value for _Select Top &lt;n&gt; Rows command" Target="{Binding ElementName=SelectTopBox}" Padding="0" VerticalAlignment="Center"/>
      <TextBox x:Name="SelectTopBox" Grid.Column="1" TextAlignment="Right" Padding="2,1" AutomationProperties.Name="Value for Select Top n Rows command"/>
      <Label Grid.Row="1" Content="Value for _Edit Top &lt;n&gt; Rows command" Target="{Binding ElementName=EditTopBox}" Padding="0" VerticalAlignment="Center" Margin="0,8,0,0"/>
      <TextBox x:Name="EditTopBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right" Padding="2,1" Margin="0,8,0,0" AutomationProperties.Name="Value for Edit Top n Rows command"/>
     </Grid>
     <TextBlock Text="Number of rows read by Select Top Rows and edited by Edit Top Rows on a table or view in Object Explorer. Defaults: 1000 and 200." TextWrapping="Wrap" Foreground="#5A5A5A" Margin="0,8,0,0"/>
     <TextBlock x:Name="CommandsError" Foreground="#B00020" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
    </StackPanel>
    <local:QueryOptionsPages x:Name="QueryPages" Visibility="Collapsed"/>
   </Grid>
  </Border>
  <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
   <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="Accept" Padding="24,4"/>
   <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="8,0,0,0"/>
  </StackPanel>
 </Grid>
</Window>
