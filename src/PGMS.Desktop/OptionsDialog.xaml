<Window x:Class="PGMS.Desktop.OptionsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PGMS.Desktop" Title="Options" Width="680" Height="480" MinWidth="560" MinHeight="400" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Pgms.DialogBackground}">
 <Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <TreeView x:Name="Pages" Background="{DynamicResource Pgms.ContentBackground}" AutomationProperties.Name="Option pages" SelectedItemChanged="PageChanged">
   <TreeViewItem Header="Environment" IsExpanded="True">
    <TreeViewItem x:Name="GeneralPage" Header="General" IsSelected="True"/>
    <TreeViewItem x:Name="FontsAndColorsPage" Header="Fonts and Colors"/>
    <TreeViewItem x:Name="KeyboardPage" Header="Keyboard"/><TreeViewItem x:Name="QueryShortcutsPage" Header="Query Shortcuts"/>
   </TreeViewItem>
   <TreeViewItem x:Name="ConnectionDialogPage" Header="Connection Dialog"/>
   <TreeViewItem Header="Designers" IsExpanded="True">
    <TreeViewItem x:Name="DesignersPage" Header="Table and Database Designers"/>
   </TreeViewItem>
   <TreeViewItem Header="Query Execution" IsExpanded="True">
    <TreeViewItem x:Name="ExecutionGeneralPage" Header="General"/>
    <TreeViewItem x:Name="ExecutionAdvancedPage" Header="Advanced"/>
    <TreeViewItem x:Name="HistoryPage" Header="Query History"/>
   </TreeViewItem>
   <TreeViewItem Header="Query Results" IsExpanded="True">
    <TreeViewItem x:Name="QueryResultsPage" Header="General"/>
    <TreeViewItem x:Name="ResultsGridPage" Header="Grid"/>
    <TreeViewItem x:Name="ResultsTextPage" Header="Text"/>
   </TreeViewItem>
   <TreeViewItem Header="Object Explorer" IsExpanded="True">
    <TreeViewItem x:Name="CommandsPage" Header="Commands"/>
    <TreeViewItem x:Name="ScriptingPage" Header="Scripting"/>
   </TreeViewItem>
  </TreeView>
  <Border Grid.Column="1" Margin="10,0,0,0" Background="{DynamicResource Pgms.ContentBackground}" BorderBrush="{DynamicResource Pgms.DialogBorder}" BorderThickness="1" Padding="12,10">
   <Grid>
    <StackPanel x:Name="GeneralPanel">
     <TextBlock Text="Window" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <CheckBox x:Name="RestoreWindowBox" Content="_Restore window size and position at startup"/>
     <TextBlock Text="When this is on, PGMS opens with the size and position it had when it was closed, maximized if it was maximized." TextWrapping="Wrap" Foreground="{DynamicResource Pgms.SecondaryText}" Margin="20,4,0,0"/>
     <TextBlock Text="Recent files" FontWeight="SemiBold" Margin="0,14,0,6"/>
     <StackPanel Orientation="Horizontal">
      <Label Content="_Items shown in File ▸ Recent Files:" Target="{Binding ElementName=RecentFilesBox}" Padding="0" VerticalAlignment="Center"/>
      <TextBox x:Name="RecentFilesBox" Width="50" Margin="8,0,0,0" AutomationProperties.Name="Items shown in Recent Files"/>
     </StackPanel>
     <TextBlock Text="From 1 to 24. The list keeps the query files opened or saved in PGMS by this Windows user." TextWrapping="Wrap" Foreground="{DynamicResource Pgms.SecondaryText}" Margin="0,4,0,0"/>
     <TextBlock x:Name="GeneralError" Foreground="{DynamicResource Pgms.ErrorText}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
    </StackPanel>
    <StackPanel x:Name="QueryResultsPanel" Visibility="Collapsed">
     <TextBlock Text="General" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
      <Label Content="_Default destination for results:" Target="{Binding ElementName=DefaultResultsBox}" Padding="0" VerticalAlignment="Center"/>
      <ComboBox x:Name="DefaultResultsBox" Grid.Column="1" AutomationProperties.Name="Default destination for results">
       <ComboBoxItem Content="Results to grid" Tag="Grid"/><ComboBoxItem Content="Results to text" Tag="Text"/><ComboBoxItem Content="Results to file" Tag="File"/>
      </ComboBox>
     </Grid>
     <TextBlock Text="Used by query windows opened from now on. Query ▸ Results To changes only the active query window." TextWrapping="Wrap" Foreground="{DynamicResource Pgms.SecondaryText}" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel x:Name="CommandsPanel" Visibility="Collapsed">
     <TextBlock Text="Table and View Options" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Label Content="Value for _Select Top &lt;n&gt; Rows command" Target="{Binding ElementName=SelectTopBox}" Padding="0" VerticalAlignment="Center"/>
      <TextBox x:Name="SelectTopBox" Grid.Column="1" TextAlignment="Right" Padding="2,1" AutomationProperties.Name="Value for Select Top n Rows command"/>
      <Label Grid.Row="1" Content="Value for _Edit Top &lt;n&gt; Rows command" Target="{Binding ElementName=EditTopBox}" Padding="0" VerticalAlignment="Center" Margin="0,8,0,0"/>
      <TextBox x:Name="EditTopBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right" Padding="2,1" Margin="0,8,0,0" AutomationProperties.Name="Value for Edit Top n Rows command"/>
     </Grid>
     <TextBlock Text="Number of rows read by Select Top Rows and edited by Edit Top Rows on a table or view in Object Explorer. Defaults: 1000 and 200." TextWrapping="Wrap" Foreground="{DynamicResource Pgms.SecondaryText}" Margin="0,8,0,0"/>
     <TextBlock x:Name="CommandsError" Foreground="{DynamicResource Pgms.ErrorText}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
    </StackPanel>
    <StackPanel x:Name="HistoryPanel" Visibility="Collapsed">
     <TextBlock Text="Query History" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <CheckBox x:Name="HistoryEnabledBox" Content="_Record executed queries in Query History"/>
     <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Label Content="_Keep executions for (days):" Target="{Binding ElementName=HistoryDaysBox}" Padding="0" VerticalAlignment="Center"/>
      <TextBox x:Name="HistoryDaysBox" Grid.Column="1" TextAlignment="Right" Padding="2,1" AutomationProperties.Name="Keep executions for days"/>
      <Label Grid.Row="1" Content="_Maximum executions kept:" Target="{Binding ElementName=HistoryCountBox}" Padding="0" VerticalAlignment="Center" Margin="0,8,0,0"/>
      <TextBox x:Name="HistoryCountBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right" Padding="2,1" Margin="0,8,0,0" AutomationProperties.Name="Maximum executions kept"/>
      <Label Grid.Row="2" Content="Maximum _SQL kept per execution (KiB):" Target="{Binding ElementName=HistorySizeBox}" Padding="0" VerticalAlignment="Center" Margin="0,8,0,0"/>
      <TextBox x:Name="HistorySizeBox" Grid.Row="2" Grid.Column="1" TextAlignment="Right" Padding="2,1" Margin="0,8,0,0" AutomationProperties.Name="Maximum SQL kept per execution in KiB"/>
     </Grid>
     <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Pgms.SecondaryText}" Margin="0,8,0,0" Text="Defaults: 90 days, 10,000 executions, 64 KiB (65,536 characters; longer SQL is cut and marked). Limits apply when PGMS starts and while it records. Past the count limit the oldest executions are removed until 95% of it is left. The newest execution of a pinned query is always kept."/>
     <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Pgms.SecondaryText}" Margin="0,8,0,0" Text="Query History is stored only on this computer, encrypted for this Windows user (DPAPI), in the PGMS folder of your local application data. It is never written to a server. A saved connection profile can turn recording off for its server."/>
     <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
      <Button x:Name="ClearHistoryButton" Content="_Clear History…" Click="ClearHistory" Padding="10,3" AutomationProperties.Name="Clear query history"/>
      <TextBlock x:Name="ClearHistoryStatus" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" AutomationProperties.Name="Clear history status"/>
     </StackPanel>
     <TextBlock x:Name="HistoryError" Foreground="{DynamicResource Pgms.ErrorText}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
    </StackPanel>
    <DockPanel x:Name="KeyboardPanel" Visibility="Collapsed">
     <Label DockPanel.Dock="Top" Content="_Show commands containing:" Target="{Binding ElementName=KeyboardFilterBox}" Padding="0,0,0,3"/>
     <TextBox DockPanel.Dock="Top" x:Name="KeyboardFilterBox" TextChanged="KeyboardFilterChanged" AutomationProperties.Name="Show commands containing"/>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
      <TextBlock Text="Shortcuts for selected command:" Margin="0,0,0,3"/>
      <DockPanel>
       <Button DockPanel.Dock="Right" x:Name="KeyboardRemoveButton" Content="_Remove" Width="80" Margin="6,0,0,0" Click="KeyboardRemove" ToolTip="Removes the shortcut you assigned; PGMS shortcuts stay"/>
       <TextBox x:Name="KeyboardCurrentBox" IsReadOnly="True" AutomationProperties.Name="Shortcuts for selected command"/>
      </DockPanel>
      <Label Content="_Press shortcut keys:" Target="{Binding ElementName=KeyboardGestureBox}" Padding="0,6,0,3"/>
      <DockPanel>
       <Button DockPanel.Dock="Right" x:Name="KeyboardAssignButton" Content="_Assign" Width="80" Margin="6,0,0,0" Click="KeyboardAssign"/>
       <TextBox x:Name="KeyboardGestureBox" IsReadOnly="True" IsReadOnlyCaretVisible="True" PreviewKeyDown="KeyboardGestureKeyDown" AutomationProperties.Name="Press shortcut keys"/>
      </DockPanel>
      <TextBlock Text="Shortcut currently used by:" Margin="0,6,0,3"/>
      <TextBox x:Name="KeyboardUsedByBox" IsReadOnly="True" AutomationProperties.Name="Shortcut currently used by"/>
      <DockPanel Margin="0,6,0,0">
       <Button DockPanel.Dock="Right" Content="R_eset" Width="80" Click="KeyboardReset" ToolTip="Removes every shortcut you assigned"/>
       <TextBlock x:Name="KeyboardMessage" TextWrapping="Wrap" Foreground="{DynamicResource Pgms.SecondaryText}" Text="An assigned shortcut works in the whole main window and wins over a PGMS shortcut with the same keys. Use Ctrl or Alt, or F1 to F24."/>
      </DockPanel>
     </StackPanel>
     <ListBox x:Name="KeyboardCommandList" Margin="0,4,0,0" SelectionChanged="KeyboardCommandChanged" AutomationProperties.Name="Commands"/>
    </DockPanel>
    <DockPanel x:Name="QueryShortcutsPanel" Visibility="Collapsed">
     <TextBlock DockPanel.Dock="Top" Text="Query shortcuts" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{DynamicResource Pgms.SecondaryText}" Margin="0,8,0,0" Text="In a connected query window the shortcut runs its text in that window's session; selected text is added after a space. For example, Ctrl+3 with TABLE runs TABLE plus the selected table name. Alt+F1 and Ctrl+1 to Ctrl+0 start empty: sp_help, sp_who and sp_lock have no PostgreSQL counterpart."/>
     <DataGrid x:Name="QueryShortcutsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single" AutomationProperties.Name="Query shortcuts">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Shortcut" Binding="{Binding Shortcut}" IsReadOnly="True" Width="80"/>
       <DataGridTextColumn Header="Query" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
    <StackPanel x:Name="ScriptingPanel" Visibility="Collapsed">
     <TextBlock Text="General scripting options" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <CheckBox x:Name="ScriptHeadersBox" Content="Include _descriptive headers"/>
     <TextBlock Text="Prefix scripts with a descriptive comment naming the object and the script date." TextWrapping="Wrap" Foreground="{DynamicResource Pgms.SecondaryText}" Margin="20,2,0,8"/>
     <CheckBox x:Name="ScriptDatabaseBox" Content="Script the _database name"/>
     <TextBlock Text="Begin scripts with a -- Database: comment. PostgreSQL has no USE &lt;database&gt;: a script runs in the database of the query window." TextWrapping="Wrap" Foreground="{DynamicResource Pgms.SecondaryText}" Margin="20,2,0,8"/>
     <TextBlock Text="Object scripting options" FontWeight="SemiBold" Margin="0,6,0,6"/>
     <CheckBox x:Name="ScriptExistenceBox" Content="_Check for object existence"/>
     <TextBlock Text="DROP and DROP and CREATE scripts use IF EXISTS, so they do not fail when the object is already gone." TextWrapping="Wrap" Foreground="{DynamicResource Pgms.SecondaryText}" Margin="20,2,0,8"/>
     <TextBlock Text="Used by Script ... as in Object Explorer from now on. Owners and permissions are not scripted, as in the SSMS defaults." TextWrapping="Wrap" Foreground="{DynamicResource Pgms.SecondaryText}" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel x:Name="DesignersPanel" Visibility="Collapsed">
     <TextBlock Text="Diagram Options" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
      <Label Content="Default _table view:" Target="{Binding ElementName=DefaultTableViewBox}" Padding="0" VerticalAlignment="Center"/>
      <ComboBox x:Name="DefaultTableViewBox" Grid.Column="1" AutomationProperties.Name="Default table view">
       <ComboBoxItem Content="Standard" Tag="Standard"/><ComboBoxItem Content="Column Names" Tag="ColumnNames"/><ComboBoxItem Content="Keys" Tag="Keys"/><ComboBoxItem Content="Name Only" Tag="NameOnly"/><ComboBoxItem Content="Custom" Tag="Custom"/>
      </ComboBox>
     </Grid>
     <CheckBox x:Name="LaunchAddTableBox" Content="_Launch Add Table dialog on new diagram" Margin="0,10,0,0"/>
     <TextBlock Text="The table view applies to tables added to a diagram from now on; tables already on a diagram keep theirs." TextWrapping="Wrap" Foreground="{DynamicResource Pgms.SecondaryText}" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel x:Name="ConnectionDialogPanel" Visibility="Collapsed">
     <TextBlock Text="Connection Dialog" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <CheckBox x:Name="SelectRecentBox" Content="_Automatically select the most recent connection"/>
     <TextBlock Text="When Connect opens, the profile used last is selected and filled in. Off, the dialog opens with no profile selected." TextWrapping="Wrap" Foreground="{DynamicResource Pgms.SecondaryText}" Margin="20,2,0,0"/>
    </StackPanel>
    <Grid x:Name="FontsAndColorsPanel" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.ColumnSpan="3">
      <Label Content="_Show settings for:" Target="{Binding ElementName=FontCategoryBox}" Padding="0,0,0,2"/>
      <ComboBox x:Name="FontCategoryBox" Width="250" HorizontalAlignment="Left" SelectionChanged="FontCategoryChanged" AutomationProperties.Name="Show settings for"/>
     </StackPanel>
     <StackPanel Grid.Row="1" Margin="0,8,0,0">
      <Label Content="_Font:" Target="{Binding ElementName=FontNameBox}" Padding="0,0,0,2"/>
      <ComboBox x:Name="FontNameBox" IsEditable="True" IsTextSearchEnabled="True" AutomationProperties.Name="Font" LostFocus="FontSampleInputChanged" SelectionChanged="FontSampleInputChanged"/>
     </StackPanel>
     <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
      <Label Content="Si_ze:" Target="{Binding ElementName=FontSizeBox}" Padding="0,0,0,2"/>
      <ComboBox x:Name="FontSizeBox" IsEditable="True" AutomationProperties.Name="Size" LostFocus="FontSampleInputChanged" SelectionChanged="FontSampleInputChanged"/>
     </StackPanel>
     <Label Grid.Row="2" x:Name="DisplayItemsLabel" Content="_Display items:" Target="{Binding ElementName=DisplayItemsBox}" Padding="0,8,0,2"/>
     <ListBox Grid.Row="3" Grid.RowSpan="2" x:Name="DisplayItemsBox" MinHeight="90" SelectionChanged="DisplayItemChanged" AutomationProperties.Name="Display items"/>
     <StackPanel Grid.Row="3" Grid.RowSpan="2" Grid.Column="2" x:Name="ItemColorsPanel">
      <Label Content="Item fo_reground:" Target="{Binding ElementName=ItemForegroundBox}" Padding="0,0,0,2"/>
      <ComboBox x:Name="ItemForegroundBox" IsEditable="True" AutomationProperties.Name="Item foreground" LostFocus="ItemColorInputChanged" SelectionChanged="ItemColorInputChanged"/>
      <Label Content="Item bac_kground:" Target="{Binding ElementName=ItemBackgroundBox}" Padding="0,8,0,2"/>
      <ComboBox x:Name="ItemBackgroundBox" IsEditable="True" AutomationProperties.Name="Item background" LostFocus="ItemColorInputChanged" SelectionChanged="ItemColorInputChanged"/>
      <CheckBox x:Name="ItemBoldBox" Content="_Bold" Margin="0,8,0,0" Click="ItemColorInputChanged"/>
     </StackPanel>
     <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,8,0,0">
      <TextBlock Text="Sample:" Margin="0,0,0,2"/>
      <Border BorderBrush="{DynamicResource Pgms.DialogBorder}" BorderThickness="1" Height="44" x:Name="FontSampleBorder">
       <TextBlock x:Name="FontSample" Text="ij = I::oO(0xB81l);" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="Sample"/>
      </Border>
      <TextBlock x:Name="FontsError" Foreground="{DynamicResource Pgms.ErrorText}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
     </StackPanel>
     <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
      <Button Content="Reset _category to defaults" Click="ResetFontCategory" Padding="8,2"/>
      <Button Content="Reset _all categories to defaults" Click="ResetAllFontCategories" Padding="8,2" Margin="8,0,0,0"/>
     </StackPanel>
    </Grid>
    <local:QueryOptionsPages x:Name="QueryPages" Visibility="Collapsed"/>
   </Grid>
  </Border>
  <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
   <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="Accept" Padding="24,4"/>
   <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="8,0,0,0"/>
  </StackPanel>
 </Grid>
</Window>
